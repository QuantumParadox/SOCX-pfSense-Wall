#!/bin/sh
# PROVIDE: socxprobes
# REQUIRE: NETWORKING
# KEYWORD: shutdown

name="socxprobes"
pid_file="/var/run/socxprobes.pid"
log_file="/var/log/socx-path-probes.log"
PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin
export PATH

is_running() {
    [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file" 2>/dev/null)" 2>/dev/null
}

case "$1" in
start|faststart|onestart|forcestart)
    if is_running; then
        echo "SOCX path probes are already running."
        exit 0
    fi
    (
        sleep "${SOCX_PATH_PROBE_BOOT_DELAY:-20}"
        exec /usr/local/bin/socx-path-probes loop
    ) >>"$log_file" 2>&1 &
    echo $! > "$pid_file"
    echo "SOCX path probes scheduled."
    ;;
stop|faststop|onestop|forcestop)
    if is_running; then
        kill "$(cat "$pid_file")" 2>/dev/null || true
        sleep 1
    fi
    rm -f "$pid_file"
    echo "SOCX path probes stopped."
    ;;
restart|fastrestart|onerestart|forcerestart)
    "$0" stop
    "$0" start
    ;;
status)
    if is_running; then echo "SOCX path probes are running."; else echo "SOCX path probes are not running."; exit 1; fi
    ;;
*)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac

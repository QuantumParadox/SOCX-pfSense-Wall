#!/bin/sh
# PROVIDE: socxweb
# REQUIRE: NETWORKING
# KEYWORD: shutdown

name="socxweb"
pid_file="/var/run/socxweb.pid"
log_file="/var/log/socx-web.log"
PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin
export PATH

is_running() {
    [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file" 2>/dev/null)" 2>/dev/null
}

case "$1" in
start|faststart|onestart|forcestart)
    if is_running; then
        echo "SOCX web is already running."
        exit 0
    fi
    host="${SOCX_WEB_HOST:-0.0.0.0}"
    port="${SOCX_WEB_PORT:-8094}"
    refresh="${SOCX_WEB_REFRESH_MS:-500}"
    (
        sleep "${SOCX_WEB_BOOT_DELAY:-10}"
        exec /usr/local/bin/socweb --host "$host" --port "$port" --interval-ms "$refresh"
    ) >>"$log_file" 2>&1 &
    echo $! > "$pid_file"
    echo "SOCX web scheduled on ${host}:${port}."
    ;;
stop|faststop|onestop|forcestop)
    if is_running; then
        kill "$(cat "$pid_file")" 2>/dev/null || true
        sleep 1
    fi
    rm -f "$pid_file"
    echo "SOCX web stopped."
    ;;
restart|fastrestart|onerestart|forcerestart)
    "$0" stop
    "$0" start
    ;;
status)
    if is_running; then
        echo "SOCX web is running."
    else
        echo "SOCX web is not running."
        exit 1
    fi
    ;;
*)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac

exit 0

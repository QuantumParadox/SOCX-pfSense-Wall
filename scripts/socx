#!/bin/sh

case "${1:-}" in
    "")
        exec sh /root/socxboard.sh
        ;;
    doctor)
        shift
        exec /usr/local/bin/socx-doctor "$@"
        ;;
    status)
        shift
        exec /usr/local/bin/socx-doctor status "$@"
        ;;
    v1-check|v1|ready|readiness)
        shift
        exec /usr/local/bin/socx-v1-check "$@"
        ;;
    autopilot|auto)
        shift
        /usr/local/bin/socx-doctor autopilot "$@"
        rc=$?
        /usr/local/bin/socx-history append >/dev/null 2>&1 || true
        exit "$rc"
        ;;
    autonomy-loop|autonomy|brainstem)
        shift
        exec /usr/local/bin/socx-autonomy-loop "$@"
        ;;
    autonomy-cron|autonomy-schedule)
        shift
        exec /usr/local/bin/socx-autonomy-cron "$@"
        ;;
    recorder-cron|recorder-schedule|flight-recorder)
        shift
        exec /usr/local/bin/socx-recorder-cron "$@"
        ;;
    menu|command|commands)
        shift
        exec /usr/local/bin/socx-menu "$@"
        ;;
    timeline)
        shift
        exec /usr/local/bin/socx-timeline "$@"
        ;;
    brief|daily-brief|soc-brief|morning-brief|morning)
        shift
        exec /usr/local/bin/socx-brief "$@"
        ;;
    mission|operator|intelligence)
        shift
        exec /usr/local/bin/socx-mission "$@"
        ;;
    chat|ask|operator-chat)
        shift
        exec /usr/local/bin/socx-chat "$@"
        ;;
    story|daily-story|soc-story)
        shift
        exec /usr/local/bin/socx-story "$@"
        ;;
    rules|rule-assistant|rule-draft)
        shift
        exec /usr/local/bin/socx-rule-assistant "$@"
        ;;
    why-now|why-now?)
        shift
        exec /usr/local/bin/socx-why-now "$@"
        ;;
    history)
        shift
        exec /usr/local/bin/socx-history "$@"
        ;;
    hardware|hw|thermal|headroom)
        shift
        exec /usr/local/bin/socx-hardware "$@"
        ;;
    stability-watch|watch-stability|overnight)
        shift
        exec /usr/local/bin/socx-stability-watch "$@"
        ;;
    glitch-watch|glitch|flicker)
        shift
        exec /usr/local/bin/socx-glitch-watch "$@"
        ;;
    baseline|perf-baseline|performance-baseline)
        shift
        exec /usr/local/bin/socx-baseline "$@"
        ;;
    speedtest-history|speed-history|speedtrend)
        shift
        exec /usr/local/bin/socx-speedtest-history "$@"
        ;;
    incident-memory|memory)
        shift
        exec /usr/local/bin/socx-incident-memory "$@"
        ;;
    notify)
        shift
        exec /usr/local/bin/socx-notify "$@"
        ;;
    notify-cron)
        shift
        exec /usr/local/bin/socx-notify-cron "$@"
        ;;
    snapshot|bundle)
        shift
        exec /usr/local/bin/socx-snapshot "$@"
        ;;
    snapshot-cron|nightly-snapshot|evidence-cron)
        shift
        exec /usr/local/bin/socx-snapshot-cron "$@"
        ;;
    incident-mode|incident-view)
        shift
        exec /usr/local/bin/socx-incident-mode "$@"
        ;;
    mode|modes)
        shift
        exec /usr/local/bin/socx-mode "$@"
        ;;
    hosts|labels|host-labels)
        shift
        exec /usr/local/bin/socx-host-labels "$@"
        ;;
    label-brain|identity|apps|now-watching)
        shift
        exec /usr/local/bin/socx-label-brain "$@"
        ;;
    repair|heal)
        shift
        exec /usr/local/bin/socx-repair "$@"
        ;;
    explain-screen|screen|explain-wall)
        shift
        exec /usr/local/bin/socx-explain-screen "$@"
        ;;
    tune)
        shift
        topic="${1:-}"
        [ $# -gt 0 ] && shift
        exec /usr/local/bin/socx-doctor "tune-$topic" "$@"
        ;;
    incident)
        shift
        exec /usr/local/bin/socx-incident "$@"
        ;;
    intel|attack|d3fend|kev)
        shift
        exec /usr/local/bin/socx-intel "$@"
        ;;
    pi-llm|llm)
        shift
        exec /usr/local/bin/socx-pi-llm-bridge "$@"
        ;;
    pi-discover|discover-pi)
        shift
        exec /usr/local/bin/socx-pi-discover "$@"
        ;;
    pi-nodes|pis|discover-pis)
        shift
        exec /usr/local/bin/socx-pi-nodes "$@"
        ;;
    explain-now|ai-explain|explain-ai)
        shift
        exec /usr/local/bin/socx-ai-explain "$@"
        ;;
    pi-llm-cron|llm-cron)
        shift
        exec /usr/local/bin/socx-pi-llm-cron "$@"
        ;;
    pi-lab|lab)
        shift
        exec /usr/local/bin/socx-pi-lab "$@"
        ;;
    speedtest|spd)
        shift
        exec /usr/local/sbin/socx-speedtest-cache "$@"
        ;;
    tmux|sessions|lazy-tmux)
        shift
        exec /usr/local/bin/socx-tmux-hub "$@"
        ;;
    observability|grafana|influx|metrics-stack)
        shift
        exec /usr/local/bin/socx-observability "$@"
        ;;
    metrics-intel|metrics-ai|why-metrics|metrics-why)
        shift
        exec /usr/local/bin/socx-metrics-intel "$@"
        ;;
    flow-export|netflow|ipfix|flows-export)
        shift
        exec /usr/local/bin/socx-flow-export "$@"
        ;;
    eve|suricata-eve|ids-eve)
        shift
        exec /usr/local/bin/socx-suricata-eve "$@"
        ;;
    topology|lldp|lldp-map|map)
        shift
        exec /usr/local/bin/socx-lldp-map "$@"
        ;;
    config-drift|drift|config-backup)
        shift
        exec /usr/local/bin/socx-config-drift "$@"
        ;;
    vault|evidence-vault)
        shift
        exec /usr/local/bin/socx-evidence-vault "$@"
        ;;
    evidence-relay|remote-evidence|remote-logs)
        shift
        exec /usr/local/bin/socx-evidence-relay "$@"
        ;;
    quarantine|quarantine-draft)
        shift
        exec /usr/local/bin/socx-quarantine-draft "$@"
        ;;
    why-slow)
        exec /usr/local/bin/socx-doctor why-slow
        ;;
    why|why-blocked)
        shift
        exec /usr/local/bin/socx-doctor why-blocked "$@"
        ;;
    services|unknown-services|unknowns)
        shift
        exec /usr/local/bin/socx-doctor unknown-services "$@"
        ;;
    *)
        exec sh /root/socxboard.sh "$@"
        ;;
esac

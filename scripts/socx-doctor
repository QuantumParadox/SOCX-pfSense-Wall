#!/bin/sh
set -u

cmd="${1:-all}"
arg="${2:-}"
ok=0
warn=0
fail=0

mark() {
    level="$1"
    shift
    case "$level" in
        OK) ok=$((ok + 1)) ;;
        WARN) warn=$((warn + 1)) ;;
        FAIL) fail=$((fail + 1)) ;;
        INFO) ;;
    esac
    printf '%-5s %s\n' "$level" "$*"
}

finish() {
    echo
    printf 'summary OK=%d WARN=%d FAIL=%d\n' "$ok" "$warn" "$fail"
    [ "$fail" -eq 0 ] || exit 1
}

age_file() {
    file="$1"
    [ -f "$file" ] || { echo ""; return; }
    now="$(date +%s)"
    mod="$(stat -f %m "$file" 2>/dev/null || stat -c %Y "$file" 2>/dev/null || echo 0)"
    [ "$mod" -gt 0 ] 2>/dev/null || { echo ""; return; }
    echo $((now - mod))
}

env_value() {
    key="$1"
    file="$2"
    [ -f "$file" ] || { echo ""; return; }
    sed -n "s/^$key=//p" "$file" 2>/dev/null | tail -1
}

status_from_age() {
    file="$1"
    good_age="$2"
    stale_age="$3"
    [ -f "$file" ] || { echo "missing"; return; }
    age="$(age_file "$file")"
    [ -n "$age" ] || { echo "unknown"; return; }
    if [ "$age" -le "$good_age" ] 2>/dev/null; then
        echo "fresh"
    elif [ "$age" -le "$stale_age" ] 2>/dev/null; then
        echo "stale"
    else
        echo "old"
    fi
}

recent_gateway_warnings() {
    file="${1:-/var/log/gateways.log}"
    max_age="${SOCX_GATEWAY_WARNING_MAX_AGE_SECONDS:-86400}"
    [ -f "$file" ] || return 0
    tail -500 "$file" 2>/dev/null |
        grep -Ei 'sendto error| alarm | down | pending | unknown | packet loss|100% loss' |
        perl -MTime::Local -ne '
            BEGIN { $max = $ENV{SOCX_GATEWAY_WARNING_MAX_AGE_SECONDS} || 86400; $now = time; $year = (localtime($now))[5] + 1900; %mon = (Jan=>0,Feb=>1,Mar=>2,Apr=>3,May=>4,Jun=>5,Jul=>6,Aug=>7,Sep=>8,Oct=>9,Nov=>10,Dec=>11); }
            if (/^([A-Z][a-z]{2})\s+(\d+)\s+(\d+):(\d+):(\d+)/ && exists $mon{$1}) {
                $t = eval { timelocal($5,$4,$3,$2,$mon{$1},$year) };
                $t -= 31536000 if defined($t) && $t > $now + 86400;
                print if defined($t) && ($now - $t) <= $max;
            } else {
                print;
            }' |
        tail -8
}

header() {
    echo "SOCX doctor: $1"
    echo "generated $(date)"
    echo
}

gateway_table() {
    /usr/local/sbin/pfSsh.php playback gatewaystatus 2>/dev/null || true
}

doctor_gateways() {
    header "gateways"
    table="$(gateway_table)"
    if [ -z "$table" ]; then
        mark FAIL "gatewaystatus unavailable"
        finish
    fi
    printf '%s\n' "$table" | awk 'NR==1 || NF {print}'
    echo
    printf '%s\n' "$table" | awk '
      NR>1 && NF>=7 {
        name=$1; mon=$2; loss=$6; status=tolower($7)
        total++
        if (name ~ /WAN/) wan++
        if (status ~ /online/) up++
        else downlist=downlist " " name ":" $7 "/" loss
        if (status ~ /pending|unknown|down|alarm/ || loss ~ /^100/) bad++
      }
      END {
        if (total == 0) print "WARN no monitored gateways parsed"
        else if (bad > 0) print "WARN gateway monitor watch: " bad "/" total " problematic" downlist
        else print "OK all parsed gateways online: " up "/" total
      }' | while IFS= read -r line; do
        set -- $line
        level="$1"; shift
        mark "$level" "$*"
    done

    dp="$(pgrep -af dpinger 2>/dev/null || true)"
    if [ -n "$dp" ]; then
        count="$(printf '%s\n' "$dp" | wc -l | awk '{print $1}')"
        mark OK "dpinger processes running: $count"
    else
        mark WARN "no dpinger processes found"
    fi

    recent="$(recent_gateway_warnings /var/log/gateways.log | tail -5)"
    if [ -n "$recent" ]; then
        mark WARN "recent gateway log warnings:"
        printf '%s\n' "$recent" | sed 's/^/      /'
    else
        mark OK "no recent gateway warning lines"
    fi
    finish
}

doctor_wan_quality() {
    header "wan quality"
    table="$(gateway_table)"
    if [ -n "$table" ]; then
        mark INFO "gateway status:"
        printf '%s\n' "$table" | awk 'NR==1 || NF {print "      " $0}'
        wan="$(printf '%s\n' "$table" | awk 'NR>1 && toupper($1) ~ /WAN/ {print; exit}')"
        [ -n "$wan" ] || wan="$(printf '%s\n' "$table" | awk 'NR>1 && NF {print; exit}')"
        if [ -n "$wan" ]; then
            name="$(printf '%s\n' "$wan" | awk '{print $1}')"
            loss="$(printf '%s\n' "$wan" | awk '{for(i=1;i<=NF;i++) if($i ~ /^[0-9.]+%$/){print $i; exit}}')"
            status="$(printf '%s\n' "$wan" | awk '{for(i=1;i<=NF;i++) if($i ~ /^[0-9.]+%$/){print $(i+1); exit}}')"
            [ -n "$status" ] || status="$(printf '%s\n' "$wan" | awk '{print $NF}')"
            case "$(printf '%s' "$status" | tr '[:upper:]' '[:lower:]')" in
                *online*) mark OK "primary gateway ${name:-WAN} online loss=${loss:-?}" ;;
                *pending*|*unknown*) mark WARN "primary gateway ${name:-WAN} status=${status:-unknown} loss=${loss:-?}" ;;
                *) mark FAIL "primary gateway ${name:-WAN} status=${status:-unknown} loss=${loss:-?}" ;;
            esac
        else
            mark WARN "no gateway rows parsed"
        fi
    else
        mark WARN "gatewaystatus unavailable"
    fi

    if [ -f /var/log/gateways.log ]; then
        bad="$(recent_gateway_warnings /var/log/gateways.log || true)"
        if [ -n "$bad" ]; then
            mark WARN "recent gateway quality warnings:"
            printf '%s\n' "$bad" | sed 's/^/      /'
        else
            mark OK "no recent gateway quality warnings"
        fi
    fi

    if [ -f /tmp/socx-speedtest-cache.env ]; then
        status="$(sed -n 's/^status=//p' /tmp/socx-speedtest-cache.env | tail -1)"
        mode="$(sed -n 's/^mode=//p' /tmp/socx-speedtest-cache.env | tail -1)"
        down="$(sed -n 's/^download_mbps=//p' /tmp/socx-speedtest-cache.env | tail -1)"
        up="$(sed -n 's/^upload_mbps=//p' /tmp/socx-speedtest-cache.env | tail -1)"
        ping="$(sed -n 's/^ping_ms=//p' /tmp/socx-speedtest-cache.env | tail -1)"
        age="$(age_file /tmp/socx-speedtest-cache.env)"
        mark INFO "speedtest ${mode:-auto} status=${status:-unknown} ${down:-?}/${up:-?}Mbps ping=${ping:-?}ms age=${age:-?}s"
    else
        mark WARN "speedtest cache missing"
    fi
    finish
}

doctor_speedtest_profiles() {
    header "speedtest profiles"
    direct="${SOCX_SPEEDTEST_DIRECT_CACHE_FILE:-/tmp/socx-speedtest-direct.env}"
    vpn="${SOCX_SPEEDTEST_VPN_CACHE_FILE:-/tmp/socx-speedtest-vpn.env}"
    active="${SOCX_SPEEDTEST_CACHE_FILE:-/tmp/socx-speedtest-cache.env}"
    client="${SOCX_SPEEDTEST_CLIENT_CACHE_FILE:-/tmp/socx-speedtest-client.env}"
    router="${SOCX_SPEEDTEST_ROUTER_CACHE_FILE:-/tmp/socx-speedtest-router.env}"
    for row in "ACTIVE:$active" "DIRECT:$direct" "VPN:$vpn" "CLIENT:$client" "ROUTER:$router"; do
        name="${row%%:*}"
        file="${row#*:}"
        if [ -f "$file" ]; then
            status="$(env_value status "$file")"
            mode="$(env_value mode "$file")"
            down="$(env_value download_mbps "$file")"
            up="$(env_value upload_mbps "$file")"
            ping="$(env_value ping_ms "$file")"
            age="$(age_file "$file")"
            case "$status" in
                ok) mark OK "$name ${down:-?}/${up:-?} Mbps ping=${ping:-?}ms mode=${mode:-?} age=${age:-?}s" ;;
                running) mark WARN "$name running mode=${mode:-?} age=${age:-?}s" ;;
                *) mark WARN "$name status=${status:-unknown} mode=${mode:-?} age=${age:-?}s" ;;
            esac
        else
            mark WARN "$name cache missing: $file"
        fi
    done
    if [ -f "$direct" ] && [ -f "$vpn" ]; then
        dd="$(env_value download_mbps "$direct")"
        du="$(env_value upload_mbps "$direct")"
        dp="$(env_value ping_ms "$direct")"
        vd="$(env_value download_mbps "$vpn")"
        vu="$(env_value upload_mbps "$vpn")"
        vp="$(env_value ping_ms "$vpn")"
        if awk -v dd="$dd" -v du="$du" -v vd="$vd" -v vu="$vu" 'BEGIN{exit !((dd+0)>0 && (du+0)>0 && (vd+0)>0 && (vu+0)>0)}'; then
            pct="$(awk -v dd="$dd" -v du="$du" -v vd="$vd" -v vu="$vu" 'BEGIN{printf "%.0f/%.0f", (vd/dd)*100, (vu/du)*100}')"
            delta="$(awk -v dp="$dp" -v vp="$vp" 'BEGIN{printf "%+.0f", (vp+0)-(dp+0)}')"
            mark INFO "VPN vs DIRECT: $pct percent throughput, latency ${delta}ms"
        fi
    fi
    mark INFO "run direct: socx speedtest direct"
    mark INFO "run VPN:    socx speedtest vpn"
    mark INFO "import:     socx speedtest import direct|vpn <down> <up> <ping> ..."
    finish
}

doctor_topology() {
    header "topology"
    if command -v lldpcli >/dev/null 2>&1; then
        cfg="$(lldpcli show configuration 2>/dev/null || true)"
        pattern="$(printf '%s\n' "$cfg" | sed -n 's/.*Interface pattern: //p' | head -1)"
        mgmt="$(printf '%s\n' "$cfg" | sed -n 's/.*Pattern for management addresses: //p' | head -1)"
        [ -n "$pattern" ] && mark OK "LLDP interfaces: $pattern" || mark WARN "LLDP interface pattern unavailable"
        [ -n "$mgmt" ] && mark OK "LLDP management address: $mgmt" || mark WARN "LLDP management address unavailable"
    else
        mark WARN "lldpcli command missing"
    fi
    if command -v lldpctl >/dev/null 2>&1; then
        neighbors="$(lldpctl 2>/dev/null || true)"
        count="$(printf '%s\n' "$neighbors" | grep -c '^[[:space:]]*Interface:' || true)"
        if [ "$count" -gt 0 ] 2>/dev/null; then
            mark OK "LLDP neighbors visible: $count"
            printf '%s\n' "$neighbors" |
                awk '
                  /^[[:space:]]*Interface:/ {iface=$2; gsub(/,/, "", iface)}
                  /^[[:space:]]*SysName:/ {sys=$2}
                  /^[[:space:]]*PortID:/ {port=$0; sub(/^[[:space:]]*PortID:[[:space:]]*/, "", port)}
                  iface != "" && (sys != "" || port != "") {print "      " iface " -> " (sys != "" ? sys : "neighbor") " " port; iface=""; sys=""; port=""}
                ' | head -8
        else
            mark WARN "LLDP is running but no neighbors are visible; enable LLDP on switch/ONT side if supported"
        fi
    fi

    if command -v socx-hosts-audit >/dev/null 2>&1; then
        mark INFO "host naming audit:"
        socx-hosts-audit 2>/dev/null | sed 's/^/      /' | head -35
    else
        mark WARN "socx-hosts-audit command missing"
    fi

    if [ -f /tmp/socx-pi-discovery.env ]; then
        dip="$(sed -n 's/^ip=//p' /tmp/socx-pi-discovery.env | tail -1)"
        dstatus="$(sed -n 's/^status=//p' /tmp/socx-pi-discovery.env | tail -1)"
        dservice="$(sed -n 's/^service=//p' /tmp/socx-pi-discovery.env | tail -1)"
        dage="$(age_file /tmp/socx-pi-discovery.env)"
        case "$dstatus" in
            ok) mark OK "Pi AI node discovered: ${dip:-?} service=${dservice:-?} age=${dage:-?}s" ;;
            found-no-llm) mark WARN "Pi candidate found: ${dip:-?} service=${dservice:-?}, but 3-LLM port is not up" ;;
            *) mark WARN "Pi discovery status=${dstatus:-unknown} ip=${dip:-?} age=${dage:-?}s" ;;
        esac
    else
        mark WARN "Pi discovery cache missing; run socx pi-discover"
    fi
    finish
}

domain_family() {
    d="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
    case "$d" in
        *microsoft*|*windowsupdate*|*office*|*xbox*|*live.com*) echo microsoft ;;
        *netflix*|*hulu*|*disney*|*roku*|*youtube*|*googlevideo*) echo streaming ;;
        *apple*|*icloud*|*mzstatic*) echo apple ;;
        *doubleclick*|*adservice*|*adsystem*|*analytics*|*metrics*) echo ads-tracker ;;
        *samsung*|*segment.io*|*cloudfront*|*akamai*|*fastly*) echo app-cdn ;;
        *) echo unknown ;;
    esac
}

doctor_dnsbl() {
    header "dnsbl"
    logs="/var/log/pfblockerng/dnsbl.log /var/log/pfblockerng/dns_reply.log"
    tmp="/tmp/socx-doctor-dnsbl.$$"
    : > "$tmp"
    for f in $logs; do
        [ -f "$f" ] && tail -1000 "$f" >> "$tmp"
    done
    if [ ! -s "$tmp" ]; then
        rm -f "$tmp"
        mark OK "no recent DNSBL log data"
        finish
        return
    fi
    mark INFO "top blocked domains:"
    awk -F, '
      $1 ~ /^DNSBL/ && NF >= 8 && $8 ~ /\./ {print $8; next}
      $1 ~ /^DNSBL/ && NF >= 3 && $3 ~ /\./ {print $3; next}
    ' "$tmp" |
        sed 's/^\.//;s/\.$//' |
        tr '[:upper:]' '[:lower:]' |
        awk 'length($0) > 5 && $0 ~ /^[a-z0-9][a-z0-9._-]*\.[a-z][a-z0-9.-]*$/ && $0 !~ /^[a-z]\.[a-z][a-z]/ && $0 !~ /^[a-z]\.com$/ && $0 !~ /^[a-z]\.net$/ && $0 !~ /^[a-z]\.org$/ {print}' |
        sort | uniq -c | sort -nr | head -12 |
        while read -r c d; do
            fam="$(domain_family "$d")"
            printf '      %-5s %-12s %s\n' "$c" "$fam" "$d"
        done
    fp="$(awk -F, '$1 ~ /^DNSBL/ && NF >= 8 && $8 ~ /\./ {print $8; next} $1 ~ /^DNSBL/ && NF >= 3 && $3 ~ /\./ {print $3; next}' "$tmp" | grep -Eic 'microsoft|windowsupdate|office|xbox|netflix|hulu|disney|youtube|googlevideo|icloud|apple')"
    if [ "$fp" -gt 0 ] 2>/dev/null; then
        mark WARN "$fp possible app/streaming/vendor blocks; check before whitelisting"
    else
        mark OK "no obvious Microsoft/streaming/vendor false-positive domains in sample"
    fi
    rm -f "$tmp"
    finish
}

doctor_dnsbl_review() {
    header "dnsbl review"
    logs="/var/log/pfblockerng/dnsbl.log /var/log/pfblockerng/dns_reply.log"
    tmp="/tmp/socx-doctor-dnsbl-review.$$"
    domains="/tmp/socx-doctor-dnsbl-domains.$$"
    : > "$tmp"
    for f in $logs; do
        [ -f "$f" ] && tail -2000 "$f" >> "$tmp"
    done
    if [ ! -s "$tmp" ]; then
        rm -f "$tmp" "$domains"
        mark OK "no recent DNSBL data to review"
        finish
        return
    fi
    awk -F, '
      $1 ~ /^DNSBL/ && NF >= 8 && $8 ~ /\./ {print $8; next}
      $1 ~ /^DNSBL/ && NF >= 3 && $3 ~ /\./ {print $3; next}
    ' "$tmp" |
        sed 's/^\.//;s/\.$//' |
        tr '[:upper:]' '[:lower:]' |
        awk 'length($0) > 5 && $0 ~ /^[a-z0-9][a-z0-9._-]*\.[a-z][a-z0-9.-]*$/ && $0 !~ /^[a-z]\.[a-z][a-z]/ && $0 !~ /^[a-z]\.com$/ && $0 !~ /^[a-z]\.net$/ && $0 !~ /^[a-z]\.org$/ {print}' |
        sort | uniq -c | sort -nr | head -30 > "$domains"

    if [ ! -s "$domains" ]; then
        rm -f "$tmp" "$domains"
        mark OK "DNSBL log present, but no clean domain samples parsed"
        finish
        return
    fi

    mark INFO "review buckets from recent DNSBL hits:"
    while read -r c d; do
        fam="$(domain_family "$d")"
        case "$fam" in
            ads-tracker) bucket="ads/tracker" ;;
            microsoft|streaming|apple|app-cdn) bucket="possible app breakage" ;;
            *) bucket="known-bad or unknown" ;;
        esac
        printf '      %-5s %-22s %-12s %s\n' "$c" "$bucket" "$fam" "$d"
    done < "$domains"

    maybe="$(awk '{print $2}' "$domains" | grep -Ei 'microsoft|windowsupdate|office|xbox|netflix|hulu|disney|youtube|googlevideo|icloud|apple|samsung|segment\.io' | head -8 || true)"
    if [ -n "$maybe" ]; then
        mark WARN "review before whitelist; likely app/vendor domains:"
        printf '%s\n' "$maybe" | sed 's/^/      /'
    else
        mark OK "no obvious app/vendor whitelist candidates in top sample"
    fi
    mark INFO "safe workflow: verify broken app -> whitelist exact FQDN -> rerun socx-doctor dnsbl-review"
    rm -f "$tmp" "$domains"
    finish
}

doctor_ids() {
    header "ids"
    tmp="/tmp/socx-doctor-ids.$$"
    find /var/log/suricata -maxdepth 2 -type f \( -name alerts.log -o -name fast.log \) 2>/dev/null |
        xargs tail -600 2>/dev/null > "$tmp"
    if [ ! -s "$tmp" ]; then
        rm -f "$tmp"
        mark OK "no recent Suricata alert data"
        finish
        return
    fi
    routine="$(grep -Eic 'SURICATA (Stream|Ethertype unknown)|Generic Protocol Command Decode|invalid ack|invalid timestamp|bad window|wrong seq|retransmission|decoder event' "$tmp" || true)"
    high="$(grep -Eiv 'SURICATA (Stream|Ethertype unknown)|Generic Protocol Command Decode|Raw pkt:' "$tmp" | grep -Eic 'Priority: 1|malware|trojan|ransom|command.?and.?control|c2 beacon|cnc|callback|exploit|blocked|drop' || true)"
    total="$(wc -l < "$tmp" | awk '{print $1}')"
    if [ "$high" -gt 0 ] 2>/dev/null; then
        mark WARN "$high high-signal IDS/IPS lines in last sample"
    else
        mark OK "no high-signal IDS/IPS lines in last sample"
    fi
    if [ "$routine" -gt 50 ] 2>/dev/null; then
        mark WARN "$routine routine Suricata decode/watch lines; consider rule suppression/tuning"
    else
        mark OK "routine IDS noise is moderate: $routine/$total"
    fi
    mark INFO "top IDS messages:"
    sed -n 's/.*\[\*\*\][[:space:]]*\(\[[^]]*\][[:space:]]*\)\{0,1\}\([^[]*\)[[:space:]]*\[\*\*\].*/\2/p' "$tmp" |
        sed 's/^ *//;s/ *$//' | sort | uniq -c | sort -nr | head -8 | sed 's/^/      /'
    rm -f "$tmp"
    finish
}

doctor_tune_ids() {
    header "tune ids"
    tmp="/tmp/socx-doctor-tune-ids.$$"
    find /var/log/suricata -maxdepth 2 -type f \( -name alerts.log -o -name fast.log \) 2>/dev/null |
        xargs tail -1200 2>/dev/null > "$tmp"
    if [ ! -s "$tmp" ]; then
        rm -f "$tmp"
        mark OK "no recent Suricata alerts to tune"
        finish
        return
    fi

    total="$(wc -l < "$tmp" | awk '{print $1}')"
    routine="$(grep -Eic 'SURICATA (Stream|Ethertype unknown)|Generic Protocol Command Decode|invalid ack|invalid timestamp|bad window|wrong seq|retransmission|decoder event|HTTP unable to match response to request' "$tmp" || true)"
    high="$(grep -Eiv 'SURICATA (Stream|Ethertype unknown)|Generic Protocol Command Decode|Raw pkt:|HTTP unable to match response to request' "$tmp" | grep -Eic 'Priority: 1|malware|trojan|ransom|command.?and.?control|c2 beacon|cnc|callback|exploit|blocked|drop' || true)"

    if [ "$high" -gt 0 ] 2>/dev/null; then
        mark WARN "$high high-signal alerts present; do not blanket-suppress"
    else
        mark OK "no high-signal alerts in sample"
    fi
    if [ "$routine" -gt 100 ] 2>/dev/null; then
        mark WARN "$routine/$total alerts look routine/noisy; good candidate for thresholding or local suppress rules"
    else
        mark OK "routine IDS noise is moderate: $routine/$total"
    fi

    mark INFO "top suppression candidates:"
    sed -n 's/.*\[\*\*\][[:space:]]*\(\[[^]]*\][[:space:]]*\)\{0,1\}\([^[]*\)[[:space:]]*\[\*\*\].*/\2/p' "$tmp" |
        sed 's/^ *//;s/ *$//' |
        grep -Ei 'SURICATA (Stream|Ethertype unknown)|Generic Protocol Command Decode|invalid ack|invalid timestamp|HTTP unable to match response to request|decoder event' |
        sort | uniq -c | sort -nr | head -10 | sed 's/^/      /'

    mark INFO "recommended action: suppress or threshold only the repeated routine signatures above; keep malware/C2/exploit rules enabled"
    mark INFO "after tuning, run: socx-doctor ids"
    rm -f "$tmp"
    finish
}

doctor_vnstat() {
    header "vnstat"
    if pgrep -f 'vnstatd' >/dev/null 2>&1; then
        mark OK "vnstatd process is running"
    else
        mark WARN "vnstatd process is not running"
    fi
    if command -v vnstat >/dev/null 2>&1; then
        out="$(vnstat --iflist 2>/dev/null || true)"
        [ -n "$out" ] && mark INFO "vnstat interfaces: $out" || mark WARN "vnstat --iflist returned no interfaces"
        vnstat --oneline 2>/dev/null | head -1 | sed 's/^/      /'
    else
        mark WARN "vnstat command missing"
    fi
    for d in /var/db/vnstat /var/lib/vnstat; do
        if [ -d "$d" ]; then
            mark OK "vnstat database directory exists: $d"
            ls -la "$d" 2>/dev/null | tail -8 | sed 's/^/      /'
        fi
    done
    finish
}

unknown_service_label() {
    port="$1"
    case "$port" in
        81|808|8080|8081|8000|8001|8888) echo web ;;
        443|844|5443|8443|9443) echo tls ;;
        540) echo legacy ;;
        943|1194|1443|4500|51820|51821) echo vpn ;;
        3000) echo ntop ;;
        3001) echo webui ;;
        4000|8886) echo app ;;
        5000) echo mlflow ;;
        5355) echo llmnr ;;
        6379) echo redis ;;
        7860) echo gradio ;;
        8086) echo influx ;;
        8089) echo splunk ;;
        8093) echo miranda ;;
        8094) echo socweb ;;
        8095) echo pi3llm ;;
        8265|10001) echo ray ;;
        8728) echo router ;;
        8889) echo jupyter ;;
        9042) echo cass ;;
        9090|9100) echo metrics ;;
        9091) echo trans ;;
        11434) echo ollama ;;
        11435) echo llm ;;
        19090) echo triton ;;
        27015|27016|27017|27018|27019|27020|27021|27022|27023|27024|27025|27026|27027|27028|27029|27030|27031|27032|27033|27034|27035|27036|27037|27038|27039|27040|27041|27042|27043|27044|27045|27046|27047|27048|27049|27050) echo game ;;
        57|291|306|935|1009|1013|1018|1020|1024) echo legacy ;;
        *) echo "" ;;
    esac
}

doctor_unknown_services() {
    header "unknown services"
    log="${SOCX_UNKNOWN_SERVICES_LOG:-/var/db/socx_unknown_services.log}"
    services="${SOCX_SERVICES_FILE:-/usr/local/etc/socx_services.conf}"
    suggestions="${SOCX_UNKNOWN_SERVICE_SUGGESTIONS:-/tmp/socx-service-suggestions.conf}"
    if [ ! -s "$log" ]; then
        mark OK "unknown-service learner is clean"
        finish
        return
    fi
    bytes="$(wc -c "$log" 2>/dev/null | awk '{print $1}')"
    mark INFO "unknown-service learner size=${bytes:-0}B"
    mark INFO "top observed ports:"
    awk 'match($0,/port=[0-9]+/){p=substr($0,RSTART+5,RLENGTH-5); c[p]++} END{for(p in c) print c[p],p}' "$log" |
        sort -nr | head -20 |
        while read -r count port; do
            label="$(unknown_service_label "$port")"
            [ -n "$label" ] || label="review"
            printf '      %-5s port %-6s suggested=%s\n' "$count" "$port" "$label"
        done
    : > "$suggestions"
    awk 'match($0,/port=[0-9]+/){p=substr($0,RSTART+5,RLENGTH-5); c[p]++} END{for(p in c) print c[p],p}' "$log" |
        sort -nr | head -40 |
        while read -r count port; do
            label="$(unknown_service_label "$port")"
            [ -n "$label" ] || continue
            if ! grep -q "^$port=" "$services" 2>/dev/null; then
                printf '%s=%s\n' "$port" "$label" >> "$suggestions"
            fi
        done
    if [ -s "$suggestions" ]; then
        mark WARN "new service-label suggestions written to $suggestions"
        sed 's/^/      /' "$suggestions"
    else
        mark OK "top unknown ports are already covered by service labels or need manual review"
    fi
    mark INFO "apply safe labels with: socx-doctor unknown-services --apply"
    mark INFO "archive learner log with: socx-doctor unknown-services --archive"
    finish
}

doctor_unknown_services_apply() {
    header "unknown services apply"
    services="${SOCX_SERVICES_FILE:-/usr/local/etc/socx_services.conf}"
    suggestions="${SOCX_UNKNOWN_SERVICE_SUGGESTIONS:-/tmp/socx-service-suggestions.conf}"
    doctor_unknown_services >/dev/null 2>&1 || true
    ok=0
    warn=0
    fail=0
    if [ ! -s "$suggestions" ]; then
        mark OK "no generated service-label suggestions to apply"
        finish
        return
    fi
    mkdir -p "$(dirname "$services")" 2>/dev/null || true
    [ -f "$services" ] || printf '# SOCX service label overrides.\n' > "$services"
    cp "$services" "$services.bak-$(date +%Y%m%d-%H%M%S)" 2>/dev/null || true
    while IFS= read -r line; do
        port="${line%%=*}"
        [ -n "$port" ] || continue
        grep -q "^$port=" "$services" 2>/dev/null && continue
        printf '%s\n' "$line" >> "$services"
    done < "$suggestions"
    mark OK "applied suggestions from $suggestions to $services"
    finish
}

doctor_unknown_services_archive() {
    header "unknown services archive"
    log="${SOCX_UNKNOWN_SERVICES_LOG:-/var/db/socx_unknown_services.log}"
    keep="${SOCX_UNKNOWN_SERVICE_KEEP_LINES:-300}"
    if [ ! -f "$log" ]; then
        mark OK "unknown-service learner log missing; nothing to archive"
        finish
        return
    fi
    archive="$log.archive-$(date +%Y%m%d-%H%M%S)"
    cp "$log" "$archive"
    tail -n "$keep" "$archive" > "$log"
    mark OK "archived learner log to $archive"
    mark OK "trimmed active learner log to last $keep lines"
    finish
}

doctor_why_slow() {
    header "why-slow"

    load="$(uptime 2>/dev/null || true)"
    [ -n "$load" ] && mark INFO "$load"

    top_line="$(top -b -n 1 2>/dev/null | head -8 || true)"
    if [ -n "$top_line" ]; then
        mark INFO "top snapshot:"
        printf '%s\n' "$top_line" | sed 's/^/      /'
    else
        mark WARN "top snapshot unavailable"
    fi

    if [ -f /tmp/socx-speedtest-cache.env ]; then
        age="$(age_file /tmp/socx-speedtest-cache.env)"
        status="$(sed -n 's/^status=//p' /tmp/socx-speedtest-cache.env | tail -1)"
        down="$(sed -n 's/^download_mbps=//p' /tmp/socx-speedtest-cache.env | tail -1)"
        up="$(sed -n 's/^upload_mbps=//p' /tmp/socx-speedtest-cache.env | tail -1)"
        ping="$(sed -n 's/^ping_ms=//p' /tmp/socx-speedtest-cache.env | tail -1)"
        mark INFO "speedtest status=${status:-unknown} down=${down:-?}Mbps up=${up:-?}Mbps ping=${ping:-?}ms age=${age:-?}s"
    else
        mark WARN "speedtest cache missing; cannot compare ISP baseline"
    fi

    gw="$(gateway_table)"
    if [ -n "$gw" ]; then
        mark INFO "gateway latency/loss:"
        printf '%s\n' "$gw" | awk 'NR==1 || NR<8 {print "      " $0}'
        bad="$(printf '%s\n' "$gw" | awk 'NR>1 && (tolower($7) !~ /online/ || $6 ~ /^[1-9]|100/) {print $1 ":" $6 "/" $7}' | tr '\n' ' ')"
        [ -n "$bad" ] && mark WARN "gateway loss/down indicators: $bad" || mark OK "parsed gateways show no loss/down indicator"
    else
        mark WARN "gatewaystatus unavailable"
    fi

    if command -v netstat >/dev/null 2>&1; then
        mark INFO "interface counters/errors:"
        netstat -ibn 2>/dev/null | awk 'NR==1 || $1 ~ /^(ix|em|igb|re|vmx|vtnet|tun|wg|enc)/ {print "      " $0}' | head -12
    fi

    pf_count="$(pfctl -ss 2>/dev/null | wc -l | awk '{print $1}')"
    if [ "$pf_count" -gt 100000 ] 2>/dev/null; then
        mark WARN "very high PF state count: $pf_count"
    else
        mark OK "PF state count: ${pf_count:-0}"
    fi
    mark INFO "top active state sample:"
    pfctl -ss 2>/dev/null | head -12 | sed 's/^/      /'
    finish
}

doctor_logs() {
    header "log pressure"
    for f in /var/log/filter.log /var/log/system.log /var/log/resolver.log /var/log/gateways.log /var/log/pfblockerng/dnsbl.log; do
        [ -f "$f" ] || continue
        bytes="$(wc -c "$f" 2>/dev/null | awk '{print $1}')"
        lines="$(tail -1000 "$f" 2>/dev/null | wc -l | awk '{print $1}')"
        case "$bytes" in ''|0) mark OK "$f empty" ;; *) mark INFO "$f size=${bytes}B sample_lines=$lines" ;; esac
    done
    top -b -n 1 2>/dev/null | head -18 | sed 's/^/      /'
    finish
}

doctor_why() {
    target="$1"
    if [ -z "$target" ]; then
        echo "Usage: socx-doctor why-blocked <host|domain|ip|port>" >&2
        exit 2
    fi
    header "why-blocked $target"
    grep -Fih "$target" /var/log/filter.log /var/log/pfblockerng/dnsbl.log /var/log/pfblockerng/dns_reply.log 2>/dev/null |
        tail -30 | sed 's/^/      /'
    hits="$(grep -Fih "$target" /var/log/filter.log /var/log/pfblockerng/dnsbl.log /var/log/pfblockerng/dns_reply.log 2>/dev/null | wc -l | awk '{print $1}')"
    if [ "$hits" -gt 0 ] 2>/dev/null; then
        mark WARN "$hits matching block/filter/DNSBL lines found"
    else
        mark OK "no direct block/DNSBL hits found for $target"
    fi
    finish
}

doctor_pi_llm() {
    header "pi llm"
    cron="${SOCX_PI_LLM_CRON_FILE:-/etc/cron.d/socx-pi-llm}"
    cache="${SOCX_PI_LLM_ANALYSIS_CACHE:-/tmp/socx-pi-llm-analysis.env}"
    discovery="${SOCX_PI_DISCOVERY_CACHE:-/tmp/socx-pi-discovery.env}"
    url="${SOCX_PI_LLM_POST_URL:-}"
    if command -v socx-pi-discover >/dev/null 2>&1; then
        socx-pi-discover | sed 's/^/      /'
    else
        mark WARN "socx-pi-discover command missing"
    fi
    if [ -f "$discovery" ]; then
        dip="$(sed -n 's/^ip=//p' "$discovery" | tail -1)"
        dstatus="$(sed -n 's/^status=//p' "$discovery" | tail -1)"
        dsource="$(sed -n 's/^source=//p' "$discovery" | tail -1)"
        dservice="$(sed -n 's/^service=//p' "$discovery" | tail -1)"
        durl="$(sed -n 's/^pi_llm_url=//p' "$discovery" | tail -1)"
        dage="$(age_file "$discovery")"
        case "$dstatus" in
            ok) mark OK "Pi discovery ip=${dip:-?} source=${dsource:-?} service=${dservice:-?} age=${dage:-?}s" ;;
            found-no-llm) mark WARN "Pi candidate ip=${dip:-?} source=${dsource:-?} service=${dservice:-?}; 3-LLM service not listening" ;;
            *) mark WARN "Pi discovery status=${dstatus:-unknown} age=${dage:-?}s" ;;
        esac
        [ -n "$url" ] || url="$durl"
    else
        mark WARN "Pi discovery cache missing"
    fi
    [ -n "$url" ] || url="http://192.168.1.180:8095/api/socx/triage"
    if [ -f "$cron" ]; then
        mark OK "Pi LLM cron installed: $cron"
        sed 's/^/      /' "$cron"
    else
        mark WARN "Pi LLM cron not installed; run socx-pi-llm-cron install"
    fi
    host="$(printf '%s' "$url" | sed -n 's#^https\{0,1\}://\([^/:]*\).*#\1#p')"
    port="$(printf '%s' "$url" | sed -n 's#^https\{0,1\}://[^/:]*:\([0-9][0-9]*\).*#\1#p')"
    [ -n "$port" ] || port=80
    if [ -n "$host" ] && command -v nc >/dev/null 2>&1 && nc -z -w 2 "$host" "$port" >/dev/null 2>&1; then
        mark OK "Pi LLM endpoint reachable: $host:$port"
    else
        mark WARN "Pi LLM endpoint not reachable yet: $url"
    fi
    if [ -f "$cache" ]; then
        status="$(sed -n 's/^status=//p' "$cache" | tail -1)"
        sev="$(sed -n 's/^severity=//p' "$cache" | tail -1)"
        roles="$(sed -n 's/^roles=//p' "$cache" | tail -1)"
        reason="$(sed -n 's/^reason=//p' "$cache" | tail -1)"
        age="$(age_file "$cache")"
        case "$status" in
            ok)
                case "$roles" in
                    0/*) mark WARN "Pi service reachable but model roles offline severity=${sev:-unknown} roles=${roles:-?} age=${age:-?}s ${reason:-}" ;;
                    3/3) mark OK "Pi 3-LLM cache ok severity=${sev:-unknown} roles=${roles:-?} age=${age:-?}s ${reason:-}" ;;
                    *) mark WARN "Pi 3-LLM partial roles severity=${sev:-unknown} roles=${roles:-?} age=${age:-?}s ${reason:-}" ;;
                esac
                ;;
            degraded) mark WARN "Pi 3-LLM degraded severity=${sev:-unknown} roles=${roles:-?} age=${age:-?}s ${reason:-}" ;;
            off) mark WARN "Pi LLM bridge disabled age=${age:-?}s ${reason:-}" ;;
            *) mark WARN "Pi LLM cache status=${status:-unknown} severity=${sev:-unknown} age=${age:-?}s ${reason:-}" ;;
        esac
    else
        mark WARN "Pi LLM analysis cache missing; run socx pi-llm"
    fi
    finish
}

doctor_status() {
    header "status"
    mark INFO "operator command center: socx doctor | socx autopilot | socx why-slow | socx services"

    if tmux has-session -t socx 2>/dev/null; then
        mark OK "SOCX wall tmux session running"
    else
        mark FAIL "SOCX wall tmux session missing; start with: soc"
    fi

    err_bytes="$(wc -c /tmp/socx-wall.err 2>/dev/null | awk '{print $1}')"
    if [ "${err_bytes:-0}" = "0" ]; then
        mark OK "wall renderer error log clean"
    else
        mark FAIL "wall renderer errors present: /tmp/socx-wall.err bytes=${err_bytes:-?}"
    fi

    if [ -f /tmp/socx-speedtest-cache.env ]; then
        spd_status="$(env_value status /tmp/socx-speedtest-cache.env)"
        spd_down="$(env_value download_mbps /tmp/socx-speedtest-cache.env)"
        spd_up="$(env_value upload_mbps /tmp/socx-speedtest-cache.env)"
        spd_ping="$(env_value ping_ms /tmp/socx-speedtest-cache.env)"
        spd_age="$(age_file /tmp/socx-speedtest-cache.env)"
        case "$spd_status" in
            ok) mark OK "Speedtest cache ok ${spd_down:-?}/${spd_up:-?} Mbps ping=${spd_ping:-?}ms age=${spd_age:-?}s" ;;
            running) mark WARN "Speedtest currently running age=${spd_age:-?}s" ;;
            *) mark WARN "Speedtest cache status=${spd_status:-unknown} age=${spd_age:-?}s" ;;
        esac
    else
        mark WARN "Speedtest cache missing; run: socx speedtest once"
    fi
    for profile_row in "DIRECT:/tmp/socx-speedtest-direct.env" "VPN:/tmp/socx-speedtest-vpn.env"; do
        pname="${profile_row%%:*}"
        pfile="${profile_row#*:}"
        if [ -f "$pfile" ]; then
            pstatus="$(env_value status "$pfile")"
            pdown="$(env_value download_mbps "$pfile")"
            pup="$(env_value upload_mbps "$pfile")"
            pping="$(env_value ping_ms "$pfile")"
            page="$(age_file "$pfile")"
            [ "$pstatus" = ok ] && mark OK "$pname Speedtest ${pdown:-?}/${pup:-?} Mbps ping=${pping:-?}ms age=${page:-?}s" || mark WARN "$pname Speedtest status=${pstatus:-unknown} age=${page:-?}s"
        else
            mark WARN "$pname Speedtest cache missing; run: socx speedtest $(printf '%s' "$pname" | tr '[:upper:]' '[:lower:]')"
        fi
    done

    ups_cache="/tmp/socx-ups-cache.env"
    [ -f "$ups_cache" ] || ups_cache="/tmp/socx-ups-cache.json"
    if [ -f "$ups_cache" ]; then
        mark OK "UPS cache present age=$(age_file "$ups_cache")s"
    else
        mark WARN "UPS cache missing; check NUT/APC collector"
    fi

    gw="$(gateway_table)"
    if [ -n "$gw" ]; then
        vpn_line="$(printf '%s\n' "$gw" | awk 'NR>1 && $1 !~ /WAN/ {total++; if (tolower($7) ~ /online/) up++} END {if (total>0) printf "%d/%d", up, total}')"
        wan_bad="$(printf '%s\n' "$gw" | awk 'NR>1 && toupper($1) ~ /WAN/ && (tolower($7) !~ /online/ || $6 ~ /^100/) {bad=1} END{print bad+0}')"
        [ "$wan_bad" = "0" ] && mark OK "WAN gateway online" || mark FAIL "WAN gateway loss/down detected"
        if [ -n "$vpn_line" ]; then
            vup="${vpn_line%/*}"
            vtot="${vpn_line#*/}"
            [ "$vup" = "$vtot" ] && mark OK "VPN gateways online $vpn_line" || mark WARN "VPN gateways partial/down $vpn_line"
        else
            mark WARN "VPN gateway status unavailable or no VPN gateways parsed"
        fi
    else
        mark WARN "gatewaystatus unavailable"
    fi

    pgrep -f 'unbound' >/dev/null 2>&1 && mark OK "DNS resolver running" || mark FAIL "DNS resolver process missing"
    pgrep -f 'vnstatd' >/dev/null 2>&1 && mark OK "vnstatd running" || mark WARN "vnstatd not running"
    command -v lldpcli >/dev/null 2>&1 && mark OK "LLDP tools installed" || mark WARN "LLDP tools missing"

    [ -f /etc/cron.d/socx-report ] && mark OK "daily SOCX report cron installed" || mark WARN "daily SOCX report cron missing"
    [ -f /etc/cron.d/socx-miranda ] && mark OK "MIRANDA export cron installed" || mark WARN "MIRANDA export cron missing"
    [ -f /etc/cron.d/socx-pi-llm ] && mark OK "Pi 3-LLM export cron installed" || mark WARN "Pi 3-LLM export cron missing"

    if [ -f /tmp/socx-pi-llm-analysis.env ]; then
        roles="$(env_value roles /tmp/socx-pi-llm-analysis.env)"
        sev="$(env_value severity /tmp/socx-pi-llm-analysis.env)"
        mark OK "Pi AI cache severity=${sev:-unknown} roles=${roles:-?} age=$(age_file /tmp/socx-pi-llm-analysis.env)s"
    else
        mark WARN "Pi AI cache missing; run: socx pi-llm"
    fi

    if [ -f /tmp/socx-miranda-analysis.env ]; then
        sev="$(env_value severity /tmp/socx-miranda-analysis.env)"
        mark OK "MIRANDA cache severity=${sev:-unknown} age=$(age_file /tmp/socx-miranda-analysis.env)s"
    else
        mark WARN "MIRANDA cache missing; run: socx-miranda-bridge"
    fi

    unknown_bytes="$(wc -c /var/db/socx_unknown_services.log 2>/dev/null | awk '{print $1}')"
    if [ "${unknown_bytes:-0}" = "0" ]; then
        mark OK "unknown-service learner clean"
    else
        mark WARN "unknown-service learner has ${unknown_bytes:-?} bytes; run: socx services"
    fi

    if [ -f /tmp/socx-autopilot.env ]; then
        mode="$(env_value mode /tmp/socx-autopilot.env)"
        score="$(env_value score /tmp/socx-autopilot.env)"
        summary="$(env_value summary /tmp/socx-autopilot.env)"
        mark INFO "Autopilot ${mode:-UNKNOWN} score=${score:-?} | ${summary:-run socx autopilot}"
    else
        mark INFO "Autopilot cache missing; run: socx autopilot"
    fi
    finish
}

doctor_autopilot() {
    header "autopilot read-only"
    cache="${SOCX_AUTOPILOT_CACHE:-/tmp/socx-autopilot.env}"
    score=100
    mode="NORMAL"
    reasons=""
    actions=""

    wall_err="$(wc -c /tmp/socx-wall.err 2>/dev/null | awk '{print $1}')"
    if [ "${wall_err:-0}" != "0" ]; then
        score=$((score - 15))
        reasons="${reasons} wall-errors"
        actions="${actions} inspect /tmp/socx-wall.err;"
    fi

    gw="$(gateway_table)"
    if [ -n "$gw" ]; then
        wan_bad="$(printf '%s\n' "$gw" | awk 'NR>1 && toupper($1) ~ /WAN/ && (tolower($7) !~ /online/ || $6 ~ /^100/) {bad=1} END{print bad+0}')"
        vpn_line="$(printf '%s\n' "$gw" | awk 'NR>1 && $1 !~ /WAN/ {total++; if (tolower($7) ~ /online/) up++} END {if (total>0) printf "%d/%d", up, total}')"
        if [ "$wan_bad" != "0" ]; then
            score=$((score - 30))
            reasons="${reasons} wan-gateway"
            actions="${actions} run socx-doctor wan-quality;"
        fi
        if [ -n "$vpn_line" ]; then
            vup="${vpn_line%/*}"
            vtot="${vpn_line#*/}"
            if [ "$vup" = "0" ] && [ "$vtot" != "0" ]; then
                score=$((score - 20))
                reasons="${reasons} vpn-down"
                actions="${actions} inspect VPN gateway status;"
            elif [ "$vup" != "$vtot" ]; then
                score=$((score - 10))
                reasons="${reasons} vpn-partial"
                actions="${actions} inspect partial VPN path;"
            fi
        fi
    else
        score=$((score - 10))
        reasons="${reasons} gateway-unknown"
        actions="${actions} run socx-doctor gateways;"
    fi

    spd="/tmp/socx-speedtest-cache.env"
    spd_direct="/tmp/socx-speedtest-direct.env"
    spd_vpn="/tmp/socx-speedtest-vpn.env"
    if [ -f "$spd" ]; then
        spd_status="$(env_value status "$spd")"
        spd_age="$(age_file "$spd")"
        if [ "$spd_status" != "ok" ]; then
            score=$((score - 8))
            reasons="${reasons} speedtest-${spd_status:-unknown}"
            actions="${actions} run socx speedtest once;"
        elif [ "${spd_age:-999999}" -gt 25200 ] 2>/dev/null; then
            score=$((score - 5))
            reasons="${reasons} speedtest-stale"
        fi
    else
        score=$((score - 8))
        reasons="${reasons} speedtest-missing"
    fi
    if [ -f "$spd_direct" ] && [ -f "$spd_vpn" ]; then
        dd="$(env_value download_mbps "$spd_direct")"
        du="$(env_value upload_mbps "$spd_direct")"
        dp="$(env_value ping_ms "$spd_direct")"
        vd="$(env_value download_mbps "$spd_vpn")"
        vu="$(env_value upload_mbps "$spd_vpn")"
        vp="$(env_value ping_ms "$spd_vpn")"
        if awk -v dd="$dd" -v du="$du" -v vd="$vd" -v vu="$vu" 'BEGIN{exit !((dd+0)>0 && (du+0)>0 && (vd+0)>0 && (vu+0)>0)}'; then
            vpn_down_pct="$(awk -v dd="$dd" -v vd="$vd" 'BEGIN{printf "%.0f", (vd/dd)*100}')"
            vpn_up_pct="$(awk -v du="$du" -v vu="$vu" 'BEGIN{printf "%.0f", (vu/du)*100}')"
            ping_delta="$(awk -v dp="$dp" -v vp="$vp" 'BEGIN{printf "%.0f", (vp+0)-(dp+0)}')"
            if [ "$vpn_down_pct" -lt 35 ] 2>/dev/null || [ "$vpn_up_pct" -lt 35 ] 2>/dev/null || [ "$ping_delta" -gt 80 ] 2>/dev/null; then
                score=$((score - 10))
                reasons="${reasons} vpn-speed"
                actions="${actions} run socx-doctor speedtest-profiles;"
            fi
        fi
    fi

    if [ -f /tmp/socx-pi-llm-analysis.env ]; then
        roles="$(env_value roles /tmp/socx-pi-llm-analysis.env)"
        sev="$(env_value severity /tmp/socx-pi-llm-analysis.env)"
        case "$roles" in
            3/3) : ;;
            "") score=$((score - 6)); reasons="${reasons} ai-cache-weak" ;;
            *) score=$((score - 10)); reasons="${reasons} ai-roles-${roles}" ;;
        esac
        case "$(printf '%s' "$sev" | tr '[:upper:]' '[:lower:]')" in
            crit|critical|high) score=$((score - 15)); reasons="${reasons} ai-${sev}" ;;
            warn|medium|med) score=$((score - 6)); reasons="${reasons} ai-${sev}" ;;
        esac
    else
        score=$((score - 6))
        reasons="${reasons} ai-missing"
        actions="${actions} run socx pi-llm;"
    fi

    fw_recent="$(tail -250 /var/log/filter.log 2>/dev/null | grep -Eic 'block|drop|reject' || true)"
    dns_recent="$(tail -1000 /var/log/pfblockerng/dnsbl.log /var/log/pfblockerng/dns_reply.log 2>/dev/null | grep -Eic 'DNSBL|sinkhole|blocked|deny' || true)"
    ids_recent="$(find /var/log/suricata -maxdepth 2 -type f \( -name alerts.log -o -name fast.log \) 2>/dev/null | xargs tail -300 2>/dev/null | grep -Eic 'Priority: 1|malware|trojan|ransom|command.?and.?control|c2|exploit|drop' || true)"

    if [ "$ids_recent" -gt 0 ] 2>/dev/null; then
        score=$((score - 20))
        reasons="${reasons} ids-high"
        actions="${actions} run socx-doctor ids;"
    fi
    if [ "$fw_recent" -gt 80 ] 2>/dev/null; then
        score=$((score - 10))
        reasons="${reasons} firewall-burst"
        actions="${actions} consider socx incident quick;"
    fi
    if [ "$dns_recent" -gt 200 ] 2>/dev/null; then
        score=$((score - 8))
        reasons="${reasons} dnsbl-burst"
        actions="${actions} run socx-doctor dnsbl-review;"
    fi

    [ "$score" -lt 0 ] && score=0
    if [ "$score" -lt 45 ]; then
        mode="INCIDENT"
    elif [ "$score" -lt 65 ]; then
        mode="INVESTIGATE"
    elif [ "$score" -lt 85 ]; then
        mode="WATCH"
    elif [ "$fw_recent" -gt 30 ] 2>/dev/null || [ "$dns_recent" -gt 50 ] 2>/dev/null; then
        mode="WATCH"
    else
        mode="NORMAL"
    fi

    [ -n "$reasons" ] || reasons="nominal"
    [ -n "$actions" ] || actions="keep monitoring;"
    summary="FW ${fw_recent:-0} DNSBL ${dns_recent:-0} IDS ${ids_recent:-0} | ${reasons# }"
    {
        echo "updated=$(date +%s)"
        echo "mode=$mode"
        echo "score=$score"
        echo "fw_recent=${fw_recent:-0}"
        echo "dnsbl_recent=${dns_recent:-0}"
        echo "ids_recent=${ids_recent:-0}"
        echo "summary=$summary"
        echo "actions=$actions"
    } > "$cache"

    case "$mode" in
        NORMAL) mark OK "Autopilot NORMAL score=$score | $summary" ;;
        WATCH) mark WARN "Autopilot WATCH score=$score | $summary" ;;
        INVESTIGATE|INCIDENT) mark WARN "Autopilot $mode score=$score | $summary" ;;
        *) mark WARN "Autopilot $mode score=$score | $summary" ;;
    esac
    mark INFO "read-only actions: $actions"
    mark INFO "cache written: $cache"
    mark INFO "Autopilot does not change firewall rules"
    finish
}

doctor_all() {
    header "all"
    if tmux has-session -t socx 2>/dev/null; then mark OK "wall tmux session is running"; else mark FAIL "wall tmux session is not running"; fi
    err_bytes="$(wc -c /tmp/socx-wall.err 2>/dev/null | awk '{print $1}')"
    [ "${err_bytes:-0}" = "0" ] && mark OK "wall error log is clean" || mark FAIL "wall error log has ${err_bytes} bytes: /tmp/socx-wall.err"
    if [ -f /tmp/socx-speedtest-cache.env ]; then
        status="$(sed -n 's/^status=//p' /tmp/socx-speedtest-cache.env | tail -1)"
        age="$(age_file /tmp/socx-speedtest-cache.env)"
        [ "$status" = "ok" ] && mark OK "speedtest cache ok, age ${age:-?}s" || mark WARN "speedtest cache status=${status:-unknown}, age ${age:-?}s"
    else
        mark WARN "speedtest cache missing"
    fi
    [ -f /tmp/socx-ups-cache.env ] || [ -f /tmp/socx-ups-cache.json ] && mark OK "UPS cache exists" || mark WARN "UPS cache missing"
    vpn_line="$(gateway_table | awk 'NR>1 && $1 !~ /WAN/ {total++; if (tolower($7) ~ /online/) up++} END {if (total>0) printf "%d/%d", up, total}')"
    if [ -n "$vpn_line" ]; then
        up="${vpn_line%/*}"; total="${vpn_line#*/}"
        [ "$up" = "$total" ] && mark OK "VPN gateways online $vpn_line" || mark WARN "VPN gateways not fully online $vpn_line"
    else
        mark WARN "VPN gateway status unavailable or no VPN gateways found"
    fi
    [ -f /etc/cron.d/socx-report ] && mark OK "daily report cron installed" || mark WARN "daily report cron missing"
    [ -f /etc/cron.d/socx-miranda ] && mark OK "MIRANDA export cron installed" || mark WARN "MIRANDA export cron missing"
    if [ -f /tmp/socx-miranda-analysis.env ]; then
        sev="$(sed -n 's/^severity=//p' /tmp/socx-miranda-analysis.env | tail -1)"
        reason="$(sed -n 's/^reason=//p' /tmp/socx-miranda-analysis.env | tail -1)"
        age="$(age_file /tmp/socx-miranda-analysis.env)"
        mark OK "MIRANDA insight cache severity=${sev:-unknown}, age ${age:-?}s, ${reason:-no reason}"
    else
        mark WARN "MIRANDA insight cache missing; run socx-miranda-bridge or wait for cron"
    fi
    [ -f /etc/cron.d/socx-pi-llm ] && mark OK "Pi 3-LLM export cron installed" || mark WARN "Pi 3-LLM export cron missing"
    if [ -f /tmp/socx-pi-discovery.env ]; then
        dstatus="$(sed -n 's/^status=//p' /tmp/socx-pi-discovery.env | tail -1)"
        dip="$(sed -n 's/^ip=//p' /tmp/socx-pi-discovery.env | tail -1)"
        dservice="$(sed -n 's/^service=//p' /tmp/socx-pi-discovery.env | tail -1)"
        dage="$(age_file /tmp/socx-pi-discovery.env)"
        [ "$dstatus" = "ok" ] && mark OK "Pi discovery found ${dip:-?} ${dservice:-?}, age ${dage:-?}s" || mark WARN "Pi discovery status=${dstatus:-unknown} ip=${dip:-?} service=${dservice:-?}, age ${dage:-?}s"
    else
        mark WARN "Pi discovery cache missing"
    fi
    if [ -f /tmp/socx-pi-llm-analysis.env ]; then
        status="$(sed -n 's/^status=//p' /tmp/socx-pi-llm-analysis.env | tail -1)"
        sev="$(sed -n 's/^severity=//p' /tmp/socx-pi-llm-analysis.env | tail -1)"
        roles="$(sed -n 's/^roles=//p' /tmp/socx-pi-llm-analysis.env | tail -1)"
        reason="$(sed -n 's/^reason=//p' /tmp/socx-pi-llm-analysis.env | tail -1)"
        age="$(age_file /tmp/socx-pi-llm-analysis.env)"
        if [ "$status" = "ok" ] && [ "$roles" = "3/3" ]; then
            mark OK "Pi 3-LLM cache severity=${sev:-unknown}, roles=${roles:-?}, age ${age:-?}s, ${reason:-no reason}"
        else
            mark WARN "Pi 3-LLM cache status=${status:-unknown}, roles=${roles:-?}, age ${age:-?}s, ${reason:-no reason}"
        fi
    else
        mark WARN "Pi 3-LLM cache missing; run socx pi-llm after Pi endpoint is online"
    fi
    pgrep -f 'vnstatd' >/dev/null 2>&1 && mark OK "vnstatd is running" || mark WARN "vnstatd is not running"
    unknown_bytes="$(wc -c /var/db/socx_unknown_services.log 2>/dev/null | awk '{print $1}')"
    [ "${unknown_bytes:-0}" = "0" ] && mark OK "unknown service learner is clean" || mark WARN "unknown service learner has ${unknown_bytes} bytes"
    finish
}

case "$cmd" in
    all|"") doctor_all ;;
    status|health) doctor_status ;;
    autopilot|auto|autonomy) doctor_autopilot ;;
    gateways|gateway|dpinger) doctor_gateways ;;
    wan-quality|quality|wan) doctor_wan_quality ;;
    speedtest-profiles|speedtests|speedtest|spd) doctor_speedtest_profiles ;;
    topology|lldp|devices) doctor_topology ;;
    dnsbl|dns) doctor_dnsbl ;;
    dnsbl-review|review-dnsbl) doctor_dnsbl_review ;;
    ids|suricata) doctor_ids ;;
    tune-ids|ids-tune|tune_ids) doctor_tune_ids ;;
    vnstat|vnstatd|traffic) doctor_vnstat ;;
    unknown-services|unknowns|services)
        case "$arg" in
            --apply|apply) doctor_unknown_services_apply ;;
            --archive|archive|trim) doctor_unknown_services_archive ;;
            *) doctor_unknown_services ;;
        esac
        ;;
    why-slow|slow) doctor_why_slow ;;
    pi-llm|llm|pi) doctor_pi_llm ;;
    logs|pressure|cpu) doctor_logs ;;
    why-blocked|why) doctor_why "$arg" ;;
    *)
        echo "Usage: socx-doctor [all|status|autopilot|gateways|wan-quality|speedtest-profiles|topology|dnsbl|dnsbl-review|ids|tune-ids|vnstat|unknown-services|why-slow|pi-llm|logs|why-blocked <term>]" >&2
        exit 2
        ;;
esac

#!/bin/sh
set -eu

HOSTS_FILE="${SOCX_HOSTS_FILE:-/usr/local/etc/socx_hosts.conf}"
OUT="${SOCX_HOSTS_AUDIT_OUT:-/tmp/socx-hosts-audit.txt}"
APPLY="${1:-}"
SUGGESTIONS="${SOCX_HOSTS_SUGGESTIONS:-/tmp/socx-hosts-suggestions.conf}"

tmp="$(mktemp /tmp/socx-hosts.XXXXXX)"
trap 'rm -f "$tmp"' EXIT
: > "$SUGGESTIONS"

{
    echo "# SOCX host audit"
    echo "# generated $(date)"
    echo
    echo "Configured host names:"
    if [ -f "$HOSTS_FILE" ]; then
        grep -Ev '^\s*(#|$)' "$HOSTS_FILE" || true
    else
        echo "missing $HOSTS_FILE"
    fi
    echo
    echo "Observed LAN devices:"
} > "$OUT"

{
    arp -an 2>/dev/null | sed -n 's/.*(\([0-9][0-9.]*\)) at \([0-9a-f:][0-9a-f:]*\).*/\1 \2 arp/p'
    pfctl -ss 2>/dev/null | awk '
      {
        for (i=1; i<=NF; i++) {
          if (match($i, /192\.168\.1\.[0-9]+/)) {
            ip=substr($i, RSTART, RLENGTH)
            print ip " - pfstate"
          }
        }
      }'
    awk '
      /lease 192\.168\.1\./ {ip=$2}
      /hardware ethernet/ {mac=$3; gsub(";","",mac)}
      /client-hostname/ {name=$2; gsub(/[\";]/,"",name)}
      /}/ {if (ip!="") {print ip " " (mac==""?"-":mac) " dhcp " (name==""?"":name)}; ip=""; mac=""; name=""}
    ' /var/dhcpd/var/db/dhcpd.leases 2>/dev/null || true
    if [ -f /tmp/socx-pi-discovery.env ]; then
        pi_ip="$(sed -n 's/^ip=//p' /tmp/socx-pi-discovery.env | tail -1)"
        pi_status="$(sed -n 's/^status=//p' /tmp/socx-pi-discovery.env | tail -1)"
        if [ -n "$pi_ip" ] && [ "$pi_status" = "ok" ]; then
            printf '%s - socx-pi Pi5-AI-Node\n' "$pi_ip"
        fi
    fi
} | sort -u > "$tmp"

awk -v hosts="$HOSTS_FILE" -v suggestions="$SUGGESTIONS" '
BEGIN {
  while ((getline line < hosts) > 0) {
    if (line ~ /^[[:space:]]*#/ || line !~ /=/) continue
    split(line, a, "=")
    known[a[1]]=a[2]
  }
}
{
  ip=$1; mac=$2; source=$3; name=$4
  split(ip, oct, ".")
  label=(ip in known ? known[ip] : "")
  status=(label=="" ? "UNKNOWN" : "KNOWN")
  printf "%-15s %-17s %-8s %-7s %s\n", ip, mac, source, status, (label!=""?label:name)
  expected=""
  lower=tolower(name " " source)
  if (lower ~ /(pi|raspberry|llm|socx-pi)/) expected="Pi5-AI-Node"
  else if (lower ~ /(synology|diskstation|ds1823|nas)/) expected="Synology-DS1823xs"
  else if (lower ~ /(netgear|ap|wireless|wlan)/) expected="WirelessAP-" oct[4]
  else if (lower ~ /(lenovo|thinkcentre|m910)/) expected="Lenovo-M910t"
  else if (lower ~ /(ups|apc|smartups)/) expected="APC-SmartUPS"
  if (label!="" && expected!="" && label != expected) {
    corrections[ip]=expected
  }
  if (label=="" && ip ~ /^192\.168\.1\./) {
    if (oct[4] == "0" || oct[4] == "255") next
    if (lower ~ /(pi|raspberry|llm|socx-pi)/) suggestion="Pi5-AI-Node"
    else if (lower ~ /(synology|diskstation|ds1823|nas)/) suggestion="Synology-DS1823xs"
    else if (lower ~ /(netgear|ap|wireless|wlan)/) suggestion="WirelessAP-" oct[4]
    else if (lower ~ /(lenovo|thinkcentre|m910)/) suggestion="Lenovo-M910t"
    else if (lower ~ /(ups|apc|smartups)/) suggestion="APC-SmartUPS"
    else suggestion=(name!=""?name:"Device-" oct[4])
    gsub(/[^A-Za-z0-9_.-]/, "", suggestion)
    missing[ip]=suggestion
  }
}
END {
  print ""
  print "Suggested additions:"
  for (ip in missing) {
    print ip "=" missing[ip]
    print ip "=" missing[ip] >> suggestions
  }
  print ""
  print "Suggested corrections:"
  for (ip in corrections) {
    print ip "=" corrections[ip]
  }
}' "$tmp" >> "$OUT"

cat "$OUT"

if [ "$APPLY" = "--apply-suggestions" ]; then
    if [ ! -s "$SUGGESTIONS" ]; then
        echo "No suggestions to apply."
        exit 0
    fi
    cp "$HOSTS_FILE" "$HOSTS_FILE.bak-$(date +%Y%m%d-%H%M%S)" 2>/dev/null || true
    while IFS= read -r line; do
        ip="${line%%=*}"
        [ -n "$ip" ] || continue
        grep -q "^$ip=" "$HOSTS_FILE" 2>/dev/null && continue
        printf '%s\n' "$line" >> "$HOSTS_FILE"
    done < "$SUGGESTIONS"
    echo
    echo "Applied suggestions from $SUGGESTIONS to $HOSTS_FILE"
fi

#!/bin/sh
# Read-only incident-mode summary for the wall and operator console.

MINUTES="${1:-${SOCX_INCIDENT_MINUTES:-60}}"
case "$MINUTES" in *[!0-9]*) MINUTES=60 ;; esac

tmp="/tmp/socx-incident-mode.$$"
dns="/tmp/socx-incident-dns.$$"
ids="/tmp/socx-incident-ids.$$"
trap 'rm -f "$tmp" "$dns" "$ids"' EXIT

tail -2000 /var/log/filter.log 2>/dev/null | grep -Ei 'block|drop|reject' > "$tmp" || true
tail -2000 /var/log/pfblockerng/dnsbl.log /var/log/pfblockerng/dns_reply.log 2>/dev/null > "$dns" || true
find /var/log/suricata -maxdepth 2 -type f \( -name alerts.log -o -name fast.log \) 2>/dev/null |
    xargs tail -800 2>/dev/null > "$ids" || true

echo "SOCX INCIDENT MODE last ${MINUTES}m"
echo "generated $(date)"
echo

if [ -f /tmp/socx-autopilot.env ]; then
    mode="$(sed -n 's/^mode=//p' /tmp/socx-autopilot.env | tail -1)"
    score="$(sed -n 's/^score=//p' /tmp/socx-autopilot.env | tail -1)"
    summary="$(sed -n 's/^summary=//p' /tmp/socx-autopilot.env | tail -1)"
    echo "VERDICT ${mode:-UNKNOWN} score=${score:-?}"
    echo "WHY ${summary:-run socx autopilot}"
    echo
fi

echo "TOP BLOCKED SOURCES"
awk -F, '$9 == "4" && $19 ~ /^[0-9]+\./ {c[$19]++} END{for (s in c) print c[s],s}' "$tmp" |
    sort -nr | head -8 | awk '{printf "  %-5s %s\n",$1,$2}'
echo

echo "TOP BLOCKED PORTS"
awk -F, '$9 == "4" && $22 ~ /^[0-9]+$/ {c[$22]++} END{for (p in c) print c[p],p}' "$tmp" |
    sort -nr | head -8 | awk '{printf "  %-5s port %s\n",$1,$2}'
echo

echo "AFFECTED LAN HOSTS"
awk -F, '$9 == "4" {if($19 ~ /^192\.168\.1\./) c[$19]++; if($20 ~ /^192\.168\.1\./) c[$20]++} END{for (h in c) print c[h],h}' "$tmp" |
    sort -nr | head -8 | awk '{printf "  %-5s %s\n",$1,$2}'
echo

echo "DNSBL DOMAINS"
awk -F, '
  $1 ~ /^DNSBL/ && NF >= 8 && $8 ~ /\./ {print $8; next}
  $1 ~ /^DNSBL/ && NF >= 3 && $3 ~ /\./ {print $3; next}
' "$dns" | sed 's/^\.//;s/\.$//' | tr '[:upper:]' '[:lower:]' |
    awk 'length($0)>5 {c[$0]++} END{for(d in c) print c[d],d}' |
    sort -nr | head -8 | awk '{printf "  %-5s %s\n",$1,$2}'
echo

echo "IDS SIGNAL"
if [ -s "$ids" ]; then
    high="$(grep -Eic 'Priority: 1|malware|trojan|ransom|command.?and.?control|c2|cnc|callback|exploit|drop' "$ids" || true)"
    routine="$(grep -Eic 'SURICATA (Stream|Ethertype unknown)|Generic Protocol Command Decode|invalid ack|invalid timestamp|decoder event|HTTP unable to match response to request' "$ids" || true)"
    echo "  high_signal=${high:-0} routine_noise=${routine:-0}"
    sed -n 's/.*\[\*\*\][[:space:]]*\(\[[^]]*\][[:space:]]*\)\{0,1\}\([^[]*\)[[:space:]]*\[\*\*\].*/\2/p' "$ids" |
        sed 's/^ *//;s/ *$//' | sort | uniq -c | sort -nr | head -6 | sed 's/^/  /'
else
    echo "  no recent Suricata alert sample"
fi
echo

echo "NEXT ACTION"
echo "  socx snapshot"
echo "  socx timeline 120"
echo "  socx-doctor dnsbl-review"
echo "  socx tune ids"

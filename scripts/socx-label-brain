#!/bin/sh
# Passive local app/device label summary for SOCX.

PY="${PYTHON:-/usr/local/bin/python3.11}"
[ -x "$PY" ] || PY="$(command -v python3 2>/dev/null || true)"

if [ -z "$PY" ]; then
    echo "SOCX Label Brain needs python3" >&2
    exit 1
fi

exec "$PY" - "$@" <<'PY'
import csv
import json
import os
import re
import subprocess
import time
from collections import Counter, defaultdict


def run(cmd, timeout=1.2):
    try:
        return subprocess.run(cmd, shell=True, text=True, capture_output=True, timeout=timeout).stdout
    except Exception:
        return ""


def app_label(text):
    value = str(text or "").lower()
    patterns = [
        (r"netflix|nflxvideo", "Netflix"),
        (r"primevideo|amazonvideo|aiv-cdn|atv-ps|media-amazon", "Prime Video"),
        (r"youtube|googlevideo|ytimg", "YouTube"),
        (r"disney|disneyplus|dssott", "Disney+"),
        (r"hulu", "Hulu"),
        (r"max\.com|hbomax|hbo", "Max"),
        (r"peacocktv|peacock", "Peacock"),
        (r"paramountplus|cbsivideo|cbsaavideo", "Paramount+"),
        (r"roku", "Roku"),
        (r"plex", "Plex"),
        (r"apple|icloud|mzstatic|itunes|aaplimg|appldnld|tv\.apple", "Apple/iCloud"),
        (r"huggingface|hf\.co", "Hugging Face"),
        (r"civitai", "Civitai"),
        (r"quantum-computing\.ibm|cloud\.ibm|ibm\.com", "IBM Quantum"),
        (r"openai|chatgpt", "OpenAI"),
        (r"anthropic|claude", "Anthropic"),
        (r"x\.ai|grok", "xAI/Grok"),
        (r"nvidia|build\.nvidia", "NVIDIA AI"),
        (r"ollama", "Ollama"),
        (r"vllm", "vLLM"),
        (r"googleapis|gstatic|googleusercontent", "Google APIs"),
        (r"doubleclick|googlesyndication|googleadservices", "Google Ads"),
        (r"microsoft|windowsupdate|office365|live\.com|msn\.com|azure", "Microsoft"),
        (r"amazonaws|cloudfront", "AWS/CloudFront"),
        (r"facebook|fbcdn|instagram|whatsapp", "Meta"),
        (r"discord", "Discord"),
        (r"spotify", "Spotify"),
        (r"steam|steampowered", "Steam"),
    ]
    for pattern, label in patterns:
        if re.search(pattern, value):
            return label
    return ""


def service_name(port):
    services = {
        "22": "ssh", "53": "dns", "80": "web", "123": "ntp", "443": "tls",
        "500": "vpn", "1194": "vpn", "1443": "vpn", "4500": "vpn", "51820": "vpn", "51821": "vpn",
        "5223": "apns", "5228": "gcm", "5230": "gcm", "6379": "redis", "7860": "gradio",
        "8000": "vllm", "8001": "vllm", "8002": "vllm", "8093": "miranda", "8094": "socx-web",
        "8095": "pi-llm", "8265": "ray", "8888": "jupyter", "8889": "jupyter",
        "9090": "metrics", "9100": "node-exporter", "11434": "ollama", "19090": "triton",
    }
    return services.get(str(port), f"port{port}" if port else "other")


def load_hosts():
    hosts = {}
    for path in [os.environ.get("SOCX_HOSTS_CONFIG"), "/usr/local/etc/socx_hosts.conf", "/root/socx_hosts.conf"]:
        if not path or not os.path.exists(path):
            continue
        for raw in open(path, errors="ignore"):
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            ip, name = line.split("=", 1)
            hosts[ip.strip()] = name.strip()
    return hosts


HOSTS = load_hosts()
HISTORY_PATH = os.environ.get("SOCX_LABEL_BRAIN_HISTORY", "/var/db/socx_label_brain.json")


def load_history():
    try:
        with open(HISTORY_PATH, errors="ignore") as fh:
            data = json.load(fh)
            return data if isinstance(data, dict) else {"devices": {}}
    except Exception:
        return {"devices": {}}


def write_history(history):
    try:
        os.makedirs(os.path.dirname(HISTORY_PATH), exist_ok=True)
        tmp = HISTORY_PATH + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(history, fh, separators=(",", ":"))
        os.replace(tmp, HISTORY_PATH)
    except Exception:
        pass


def pretty_host(ip):
    if ip in HOSTS:
        return f"{HOSTS[ip]}/LAN.{ip.rsplit('.', 1)[-1]}" if ip.startswith("192.168.1.") else HOSTS[ip]
    if ip.startswith("192.168.1."):
        return f"LAN.{ip.rsplit('.', 1)[-1]}"
    if re.match(r"^\d+\.\d+\.\d+\.\d+$", ip):
        parts = ip.split(".")
        return f"EXT.{parts[2]}.{parts[3]}"
    return ip or "unknown"


def profile_for(asset, apps, services):
    text = " ".join([asset, " ".join(apps), " ".join(services)]).lower()
    if any(token in text for token in ["ollama", "vllm", "hugging face", "openai", "miranda", "pi-llm", "gradio", "jupyter", "ray"]):
        return "AI lab"
    if any(token in text for token in ["netflix", "prime video", "youtube", "disney", "hulu", "max", "plex", "roku"]):
        return "streaming"
    if any(token in text for token in ["nas", "smb", "mail", "imaps"]):
        return "storage"
    if any(token in text for token in ["ups", "nut", "snmp"]):
        return "sensor"
    if any(token in text for token in ["pfsense", "router", "dns", "dhcp"]):
        return "network"
    if any(token in text for token in ["ibm quantum", "qiskit", "civitai"]):
        return "research"
    return "workstation" if "lan." in text.lower() else "device"


devices = defaultdict(lambda: {"flows": 0, "services": Counter(), "apps": Counter(), "domains": Counter()})
history = load_history()

states = run("pfctl -ss 2>/dev/null | head -260")
for line in states.splitlines():
    match = re.search(r"\b(?P<proto>tcp|udp|icmp)\b.*?\((?P<src>192\.168\.1\.\d+):(?P<sport>\d+)\)\s+->\s+(?P<dst>[0-9a-fA-F:.]+):(?P<dport>\d+)", line, re.I)
    if not match:
        match = re.search(r"\b(?P<proto>tcp|udp|icmp)\b\s+(?P<src>192\.168\.1\.\d+):(?P<sport>\d+)\s+->\s+(?P<dst>[0-9a-fA-F:.]+):(?P<dport>\d+)", line, re.I)
    if not match:
        continue
    asset = pretty_host(match.group("src"))
    port = match.group("dport")
    devices[asset]["flows"] += 1
    devices[asset]["services"][service_name(port)] += 1

dns = run("tail -n 2200 /var/log/pfblockerng/dnsbl.log /var/log/pfblockerng/dns_reply.log /var/log/resolver.log 2>/dev/null | tail -900")
for line in dns.splitlines():
    ips = re.findall(r"\b(192\.168\.1\.\d+)\b", line)
    if not ips:
        continue
    domains = [d.strip(".").lower() for d in re.findall(r"([a-z0-9][a-z0-9._-]+\.[a-z][a-z0-9.-]+)", line.lower())]
    for domain in domains:
        app = app_label(domain)
        if not app:
            continue
        for ip in ips[:2]:
            asset = pretty_host(ip)
            devices[asset]["apps"][app] += 1
            devices[asset]["domains"][domain] += 1

print("SOCX Label Brain")
print("source: local pf states + DNS/DNSBL/resolver logs + host labels")
print("privacy: no external lookups")
print()
rows = []
for asset, data in devices.items():
    app_names = [name for name, _ in data["apps"].most_common(3)]
    svc_names = [name for name, _ in data["services"].most_common(3)]
    apps = ", ".join(app_names) or "--"
    svcs = ", ".join(svc_names) or "--"
    conf = "high" if data["apps"] and data["flows"] else ("medium" if data["apps"] or data["flows"] >= 3 else "low")
    profile = profile_for(asset, app_names, svc_names)
    hist = history.get("devices", {}).get(asset, {})
    odd = []
    if int(hist.get("seen", 0) or 0) >= 3:
        known_apps = set(hist.get("apps", []))
        known_svcs = set(hist.get("services", []))
        odd = [name for name in app_names if name not in known_apps]
        odd += [name for name in svc_names if name.startswith("port") and name not in known_svcs]
    rows.append((len(data["apps"]), data["flows"], asset, apps, svcs, profile, conf, ", ".join(odd[:3]) or "--"))

hist_devices = history.setdefault("devices", {})
for _, _, asset, apps, svcs, profile, _, _ in rows:
    entry = hist_devices.setdefault(asset, {"seen": 0, "apps": [], "services": [], "profile": profile})
    entry["seen"] = int(entry.get("seen", 0) or 0) + 1
    entry["profile"] = profile
    for key, values in [("apps", [v.strip() for v in apps.split(",") if v.strip() and v.strip() != "--"]), ("services", [v.strip() for v in svcs.split(",") if v.strip() and v.strip() != "--"])]:
        merged = []
        for value in [*values, *entry.get(key, [])]:
            if value and value not in merged:
                merged.append(value)
        entry[key] = merged[:12]
    entry["last_seen"] = int(time.time())
history["updated"] = int(time.time())
write_history(history)

if not rows:
    print("No active label evidence yet.")
else:
    print(f"{'DEVICE':30} {'LIKELY APPS':30} {'PROFILE':12} {'CONF':6} ODD")
    print("-" * 102)
    for _, _, asset, apps, svcs, profile, conf, odd in sorted(rows, reverse=True)[:16]:
        left = f"{apps[:20]} / {svcs[:8]}"
        print(f"{asset[:30]:30} {left[:30]:30} {profile[:12]:12} {conf[:6]:6} {odd[:18]}")

top = Counter()
for data in devices.values():
    top.update(data["apps"])
if top:
    print()
    print("Now watching:")
    print("  " + " | ".join(f"{name} x{count}" for name, count in top.most_common(8)))
PY

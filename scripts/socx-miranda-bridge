#!/bin/sh
set -u

OUT="${SOCX_MIRANDA_EXPORT:-/tmp/socx-miranda-export.json}"
POST_URL="${SOCX_MIRANDA_POST_URL:-}"
ANALYSIS_CACHE="${SOCX_MIRANDA_ANALYSIS_CACHE:-/tmp/socx-miranda-analysis.env}"

fw="$(tail -2000 /var/log/filter.log 2>/dev/null | grep -Eic ',block,|,reject,' || true)"
dns="$(tail -2000 /var/log/pfblockerng/dnsbl.log 2>/dev/null | wc -l | awk '{print $1}' || echo 0)"
ids="$(find /var/log/suricata -type f -name alerts.log -maxdepth 2 2>/dev/null | xargs tail -300 2>/dev/null | wc -l | awk '{print $1}' || echo 0)"
ids_high="$(find /var/log/suricata -maxdepth 2 -type f \( -name alerts.log -o -name fast.log \) 2>/dev/null | xargs tail -300 2>/dev/null | grep -Eiv 'SURICATA (Stream|Ethertype unknown|TCPv[46] invalid checksum|UDPv[46] invalid checksum|ICMPv[46] invalid checksum|QUIC failed decrypt)|Generic Protocol Command Decode|Raw pkt:|invalid ack|invalid timestamp|bad window|wrong seq|retransmission|decoder event|HTTP unable to match response to request' | grep -Eic 'malware|trojan|ransom|command.?and.?control|c2 beacon|cnc|callback|exploit|shellcode|botnet|coinminer|credential|phish|blacklist|known.?bad' || true)"
ids_watch=$((ids - ids_high))
[ "$ids_watch" -ge 0 ] 2>/dev/null || ids_watch=0
vpn="$(/usr/local/sbin/pfSsh.php playback gatewaystatus 2>/dev/null | tr '\n' ' ' | sed 's/"/\\"/g' | cut -c1-800)"
speed="$(cat /tmp/socx-speedtest-cache.env 2>/dev/null | tr '\n' ';' | sed 's/"/\\"/g' | cut -c1-800)"
unknown="$(tail -20 /var/db/socx_unknown_services.log 2>/dev/null | sed 's/"/\\"/g' | awk '{printf "%s\\n",$0}' | tr '\n' ';' | cut -c1-800)"
flow_lines="$(pfctl -ss 2>/dev/null | tail -n +2 | head -12 | sed 's/"/\\"/g' | tr '\n' ';' | cut -c1-1800)"
arp_lines="$(arp -an 2>/dev/null | head -32 | sed 's/"/\\"/g' | tr '\n' ';' | cut -c1-2400)"
incident_mode="$(socx incident-mode 120 2>/dev/null | sed 's/"/\\"/g' | tr '\n' ';' | cut -c1-2400)"
pi_nodes="$(socx pi-nodes 2>/dev/null | sed 's/"/\\"/g' | tr '\n' ';' | cut -c1-2000)"
label_brain="$(socx label-brain 2>/dev/null | sed 's/"/\\"/g' | tr '\n' ';' | cut -c1-2400)"
top_talkers="$(pfctl -ss 2>/dev/null | awk '
  /192\.168\.1\./ {
    for (i=1; i<=NF; i++) {
      if ($i ~ /192\.168\.1\.[0-9]+/) {
        gsub(/[^0-9.].*/, "", $i)
        host[$i]++
      }
    }
  }
  END {
    for (h in host) print host[h], h
  }' | sort -nr | head -8 | sed 's/"/\\"/g' | tr '\n' ';' | cut -c1-800)"
intel="{}"
if command -v fetch >/dev/null 2>&1; then
    tmp_intel="$(fetch -qo - http://127.0.0.1:8094/api/intel 2>/dev/null | tr -d '\r' | cut -c1-5000 || true)"
    case "$tmp_intel" in
        \{*) intel="$tmp_intel" ;;
    esac
elif command -v curl >/dev/null 2>&1; then
    tmp_intel="$(curl -fsS --max-time 3 http://127.0.0.1:8094/api/intel 2>/dev/null | tr -d '\r' | cut -c1-5000 || true)"
    case "$tmp_intel" in
        \{*) intel="$tmp_intel" ;;
    esac
fi

cat > "$OUT" <<EOF
{
  "source": "SOCX-pfSense-Wall",
  "generated_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "summary": {
    "firewall_blocks_sampled": $fw,
    "dnsbl_lines_sampled": $dns,
    "ids_alert_lines_sampled": $ids,
    "ids_high_sampled": $ids_high,
    "ids_watch_sampled": $ids_watch
  },
  "vpn_gateway_status": "$vpn",
  "speedtest_cache": "$speed",
  "unknown_services": "$unknown",
  "flow_lines": "$flow_lines",
  "arp_lines": "$arp_lines",
  "incident_mode": "$incident_mode",
  "pi_nodes": "$pi_nodes",
  "label_brain": "$label_brain",
  "top_talkers": "$top_talkers",
  "intel": $intel,
  "recommended_prompt": "Summarize SOCX network health, ATT&CK/D3FEND/KEV context, likely benign noise vs items worth checking, device/app identity from Label Brain, unusual behavior vs learned profiles, and evidence-preserving next steps."
}
EOF

echo "$OUT"

if [ -n "$POST_URL" ]; then
    if command -v curl >/dev/null 2>&1; then
        resp="$(curl -fsS -X POST -H 'Content-Type: application/json' --data-binary "@$OUT" "$POST_URL")"
        printf '%s\n' "$resp"
        severity="$(printf '%s' "$resp" | sed -n 's/.*"severity"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
        confidence="$(printf '%s' "$resp" | sed -n 's/.*"confidence"[[:space:]]*:[[:space:]]*\([0-9.][0-9.]*\).*/\1/p' | head -1)"
        reason="$(printf '%s' "$resp" | sed -n 's/.*"reasons"[[:space:]]*:[[:space:]]*\["\([^"]*\)".*/\1/p' | head -1 | sed 's/[;&|`$<>]//g')"
        next="$(printf '%s' "$resp" | sed -n 's/.*"recommended_next_step"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1 | sed 's/[;&|`$<>]//g')"
        {
            echo "updated=$(date +%s)"
            echo "status=ok"
            echo "severity=${severity:-UNKNOWN}"
            echo "confidence=${confidence:-}"
            echo "reason=${reason:-SOCX analyzed}"
            echo "next=${next:-}"
        } > "$ANALYSIS_CACHE"
    else
        echo "curl not installed; set up a local collector or copy $OUT" >&2
        exit 1
    fi
fi

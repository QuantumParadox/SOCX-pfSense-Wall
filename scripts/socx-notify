#!/bin/sh
# Optional SOCX notification hook. Posts only when configured.

WEBHOOK="${SOCX_NOTIFY_WEBHOOK_URL:-}"
TITLE="${1:-SOCX}"
MESSAGE="${2:-$(cat 2>/dev/null)}"
MODE="${SOCX_NOTIFY_MODE:-manual}"

env_get() {
    key="$1"; file="$2"
    [ -f "$file" ] || return
    sed -n "s/^$key=//p" "$file" 2>/dev/null | tail -1
}

if [ "$TITLE" = "rules" ]; then
    [ -x /usr/local/bin/socx-doctor ] && /usr/local/bin/socx-doctor autopilot >/dev/null 2>&1 || true
    auto=/tmp/socx-autopilot.env
    mode="$(env_get mode "$auto")"
    score="$(env_get score "$auto")"
    summary="$(env_get summary "$auto")"
    ids="$(env_get ids_recent "$auto")"
    sensor="$(env_get sensor_score "$auto")"
    note=""
    case "$mode" in
        INCIDENT|INVESTIGATE|"WAN DEGRADED"|"VPN DEGRADED"|"SECURITY WATCH") note="SOCX ${mode:-UNKNOWN} score=${score:-?}: ${summary:-review wall}" ;;
    esac
    [ "${ids:-0}" -gt "${SOCX_NOTIFY_IDS_THRESHOLD:-0}" ] 2>/dev/null && note="${note}${note:+ | }IDS alerts ${ids}"
    [ "${sensor:-100}" -lt "${SOCX_NOTIFY_SENSOR_MIN:-70}" ] 2>/dev/null && note="${note}${note:+ | }sensor score ${sensor}"
    if [ -z "$note" ]; then
        echo "notification rules quiet: mode=${mode:-UNKNOWN} score=${score:-?}"
        exit 0
    fi
    TITLE="SOCX ${mode:-WATCH}"
    MESSAGE="$note"
    MODE="rules"
fi

if [ -z "$WEBHOOK" ]; then
    echo "notification skipped: SOCX_NOTIFY_WEBHOOK_URL not set"
    exit 0
fi

payload=$(printf '{"text":"%s: %s"}' "$(printf '%s' "$TITLE" | sed 's/"/\\"/g')" "$(printf '%s' "$MESSAGE" | sed 's/"/\\"/g')")
if command -v fetch >/dev/null 2>&1; then
    printf '%s' "$payload" | fetch -q -o - --method POST --header 'Content-Type: application/json' --body-file - "$WEBHOOK" >/dev/null
elif command -v curl >/dev/null 2>&1; then
    curl -fsS -H 'Content-Type: application/json' -d "$payload" "$WEBHOOK" >/dev/null
else
    echo "notification failed: fetch/curl missing" >&2
    exit 1
fi
echo "notification sent mode=$MODE"

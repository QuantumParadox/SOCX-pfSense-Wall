#!/bin/sh
# Draw the bottom pane floor in tmux's pane-border layer.
width=${1:-80}
pane=${2:-0}

case "$width" in
    ''|*[!0-9]*) width=80 ;;
esac

# Only the lower IFTop/TCPDump panes need the floor. The top dashboard already
# has a native tmux divider underneath it.
case "$pane" in
    1|2) ;;
    *) exit 0 ;;
esac

[ "$width" -lt 1 ] && width=1

awk -v w="$width" 'BEGIN {
    for (i = 0; i < w; i++) printf "═";
}'

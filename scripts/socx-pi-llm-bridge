#!/bin/sh
set -u

OUT="${SOCX_PI_LLM_EXPORT:-/tmp/socx-pi-llm-export.json}"
DISCOVERY_CACHE="${SOCX_PI_DISCOVERY_CACHE:-/tmp/socx-pi-discovery.env}"
POST_URL="${SOCX_PI_LLM_POST_URL:-}"
NETWORK_POST_URL="${SOCX_PI_NETWORK_POST_URL:-}"
INGEST_TOKEN_FILE="${SOCX_PI_INGEST_TOKEN_FILE:-/usr/local/etc/socx_pi_ingest_token}"
ANALYSIS_CACHE="${SOCX_PI_LLM_ANALYSIS_CACHE:-/tmp/socx-pi-llm-analysis.env}"
TIMEOUT="${SOCX_PI_LLM_TIMEOUT:-125}"
LOCKDIR="${SOCX_PI_LLM_LOCKDIR:-/tmp/socx-pi-llm-bridge.lock}"

if ! mkdir "$LOCKDIR" 2>/dev/null; then
    write_stale="$(date +%s)"
    old="$(stat -f %m "$LOCKDIR" 2>/dev/null || stat -c %Y "$LOCKDIR" 2>/dev/null || echo 0)"
    if [ "$old" -gt 0 ] 2>/dev/null && [ $((write_stale - old)) -gt "${SOCX_PI_LLM_LOCK_STALE_SECONDS:-420}" ]; then
        rm -rf "$LOCKDIR" 2>/dev/null || true
        mkdir "$LOCKDIR" 2>/dev/null || {
            echo "SOCX Pi LLM bridge already running; stale lock removal failed" >&2
            exit 0
        }
    else
        echo "SOCX Pi LLM bridge already running; skipping this cycle" >&2
        exit 0
    fi
fi
trap 'rm -rf "$LOCKDIR"' EXIT INT TERM

discover_pi_url() {
    if command -v socx-pi-discover >/dev/null 2>&1; then
        socx-pi-discover >/tmp/socx-pi-discover.out 2>/tmp/socx-pi-discover.err || true
    fi
    if [ -f "$DISCOVERY_CACHE" ]; then
        sed -n 's/^pi_llm_url=//p' "$DISCOVERY_CACHE" | tail -1
    fi
}

write_cache() {
    status="$1"
    severity="$2"
    confidence="$3"
    reason="$4"
    next="$5"
    source="$6"
    roles="$7"
    {
        echo "updated=$(date +%s)"
        echo "status=$status"
        echo "severity=${severity:-UNKNOWN}"
        echo "confidence=${confidence:-}"
        echo "reason=$(printf '%s' "${reason:-}" | sed 's/[;&|`$<>]//g' | cut -c1-220)"
        echo "next=$(printf '%s' "${next:-}" | sed 's/[;&|`$<>]//g' | cut -c1-220)"
        echo "source=${source:-pi-llm}"
        echo "roles=${roles:-}"
        echo "post_url=$POST_URL"
    } > "$ANALYSIS_CACHE"
}

if command -v socx-miranda-bridge >/dev/null 2>&1; then
    SOCX_MIRANDA_EXPORT="$OUT" SOCX_MIRANDA_POST_URL= socx-miranda-bridge >/dev/null 2>&1 || true
fi

if [ ! -s "$OUT" ]; then
    write_cache "error" "WARN" "" "SOCX export missing; cannot send to Pi LLM" "" "pi-llm" "0/3"
    echo "SOCX Pi LLM export missing: $OUT" >&2
    exit 1
fi

if [ -z "$POST_URL" ]; then
    POST_URL="$(discover_pi_url)"
fi

if [ -z "$NETWORK_POST_URL" ]; then
    NETWORK_POST_URL="$(printf '%s' "$POST_URL" | sed 's#/api/socx/triage$#/api/socx/network#')"
fi

AUTH_HEADER=""
if [ -s "$INGEST_TOKEN_FILE" ]; then
    AUTH_HEADER="Authorization: Bearer $(tr -d '\r\n' < "$INGEST_TOKEN_FILE")"
fi

if [ -z "$POST_URL" ]; then
    write_cache "error" "WARN" "" "Pi LLM bridge cannot find Raspberry Pi; run socx-pi-discover" "" "pi-llm" "0/3"
    echo "$OUT"
    exit 1
fi

if ! command -v curl >/dev/null 2>&1; then
    write_cache "error" "WARN" "" "curl missing on pfSense; cannot post to Pi LLM" "" "pi-llm" "0/3"
    echo "curl not installed; copy $OUT to the Pi or install curl" >&2
    exit 1
fi

if [ -n "$AUTH_HEADER" ]; then
    resp="$(curl -fsS --max-time "$TIMEOUT" -X POST -H 'Content-Type: application/json' -H "$AUTH_HEADER" --data-binary "@$OUT" "$POST_URL" 2>/tmp/socx-pi-llm-curl.err)"
else
    resp="$(curl -fsS --max-time "$TIMEOUT" -X POST -H 'Content-Type: application/json' --data-binary "@$OUT" "$POST_URL" 2>/tmp/socx-pi-llm-curl.err)"
fi
rc=$?
if [ "$rc" -ne 0 ]; then
    err="$(cat /tmp/socx-pi-llm-curl.err 2>/dev/null | tr '\n' ' ' | cut -c1-180)"
    write_cache "error" "WARN" "" "Pi LLM unreachable: ${err:-curl exit $rc}" "" "pi-llm" "0/3"
    echo "SOCX Pi LLM post failed: ${err:-curl exit $rc}" >&2
    exit "$rc"
fi

# Refresh the lightweight digital twin independently of the slower LLM result.
if [ -n "$AUTH_HEADER" ]; then
    curl -fsS --max-time 5 -X POST -H 'Content-Type: application/json' -H "$AUTH_HEADER" --data-binary "@$OUT" "$NETWORK_POST_URL" >/dev/null 2>&1 || true
else
    curl -fsS --max-time 5 -X POST -H 'Content-Type: application/json' --data-binary "@$OUT" "$NETWORK_POST_URL" >/dev/null 2>&1 || true
fi

printf '%s\n' "$resp"
parsed="$(printf '%s' "$resp" | python3.11 -c '
import json,sys
try:
    d=json.load(sys.stdin)
except Exception:
    d={}
reasons=d.get("reasons") if isinstance(d.get("reasons"), list) else []
print("severity=" + str(d.get("severity") or ""))
print("confidence=" + str(d.get("confidence") or ""))
print("reason=" + str(reasons[0] if reasons else ""))
print("next=" + str(d.get("recommended_next_step") or ""))
print("source=" + str(d.get("source") or "pi-3llm"))
print("roles=" + str(d.get("roles_online") or ""))
')"
severity="$(printf '%s\n' "$parsed" | sed -n 's/^severity=//p' | tail -1)"
confidence="$(printf '%s\n' "$parsed" | sed -n 's/^confidence=//p' | tail -1)"
reason="$(printf '%s\n' "$parsed" | sed -n 's/^reason=//p' | tail -1)"
next="$(printf '%s\n' "$parsed" | sed -n 's/^next=//p' | tail -1)"
source="$(printf '%s\n' "$parsed" | sed -n 's/^source=//p' | tail -1)"
roles="$(printf '%s\n' "$parsed" | sed -n 's/^roles=//p' | tail -1)"
cache_status="ok"
case "$roles" in
    0/*)
        cache_status="degraded"
        severity="WARN"
        reason="Pi orchestrator online but model roles offline; ${reason:-check Ollama on Raspberry Pi}"
        next="${next:-Start Ollama on the Raspberry Pi and verify http://127.0.0.1:11434/api/tags}"
        ;;
esac

write_cache "$cache_status" "${severity:-INFO}" "${confidence:-}" "${reason:-Pi 3-LLM SOCX analysis received}" "${next:-}" "${source:-pi-3llm}" "${roles:-}"

#!/bin/sh
set -u

OUTDIR="${SOCX_REPORT_DIR:-/root/socx-reports}"
PERIOD="${1:-daily}"
STAMP="$(date +%Y%m%d-%H%M%S)"
OUT="$OUTDIR/socx-$PERIOD-$STAMP.txt"

mkdir -p "$OUTDIR"

section() {
    {
        echo
        echo "## $1"
        echo
    } >> "$OUT"
}

run() {
    "$@" >> "$OUT" 2>&1 || true
}

{
    echo "SOCX $PERIOD report"
    echo "Generated: $(date)"
    echo "Host: $(hostname 2>/dev/null || echo pfSense)"
} > "$OUT"

section "Executive Summary"
fw="$(tail -2000 /var/log/filter.log 2>/dev/null | grep -Eic ',block,|,reject,' || true)"
dns="$(tail -2000 /var/log/pfblockerng/dnsbl.log 2>/dev/null | wc -l | awk '{print $1}' || echo 0)"
ids="$(find /var/log/suricata -type f -name alerts.log -maxdepth 2 2>/dev/null | xargs tail -300 2>/dev/null | wc -l | awk '{print $1}' || echo 0)"
echo "Firewall blocks sampled: $fw" >> "$OUT"
echo "DNSBL lines sampled: $dns" >> "$OUT"
echo "Suricata alert lines sampled: $ids" >> "$OUT"

if [ "$PERIOD" = "weekly" ]; then
    section "Weekly Executive Rollup"
    echo "Purpose: one-page operator summary for SOCX, pfSense, Pi AI, Speedtest, and repeated security noise." >> "$OUT"
    echo "" >> "$OUT"
    if command -v socx-speedtest-history >/dev/null 2>&1; then
        echo "Speedtest path trend:" >> "$OUT"
        socx-speedtest-history summary 1200 >> "$OUT" 2>&1 || true
    fi
    echo "" >> "$OUT"
    if command -v socx-incident-memory >/dev/null 2>&1; then
        echo "Repeated incident memory:" >> "$OUT"
        socx-incident-memory summary 1200 >> "$OUT" 2>&1 || true
    fi
    echo "" >> "$OUT"
    if command -v socx-label-brain >/dev/null 2>&1; then
        echo "Top learned device identities:" >> "$OUT"
        socx-label-brain 2>/dev/null | head -18 >> "$OUT" || true
    fi
    echo "" >> "$OUT"
    echo "Recommended v1 gate:" >> "$OUT"
    if command -v socx-v1-check >/dev/null 2>&1; then
        socx-v1-check >> "$OUT" 2>&1 || true
    else
        echo "socx-v1-check not installed." >> "$OUT"
    fi
fi

section "Speedtest"
if [ -f /tmp/socx-speedtest-cache.env ]; then
    cat /tmp/socx-speedtest-cache.env >> "$OUT"
elif [ -f /tmp/socx-speedtest-cache.json ]; then
    cat /tmp/socx-speedtest-cache.json >> "$OUT"
else
    echo "No speedtest cache found." >> "$OUT"
fi

section "Speedtest History"
if command -v socx-speedtest-history >/dev/null 2>&1; then
    run socx-speedtest-history summary 500
else
    echo "socx-speedtest-history not installed." >> "$OUT"
fi

section "UPS"
if [ -f /tmp/socx-ups-cache.env ]; then
    cat /tmp/socx-ups-cache.env >> "$OUT"
elif [ -f /tmp/socx-ups-cache.json ]; then
    cat /tmp/socx-ups-cache.json >> "$OUT"
else
    echo "No UPS cache found." >> "$OUT"
fi

section "VPN And Gateways"
run /usr/local/sbin/pfSsh.php playback gatewaystatus
run sh -c 'wg show 2>/dev/null || true'
if command -v socx-doctor >/dev/null 2>&1; then
    run socx-doctor gateways
fi

section "SOCX Doctor DNSBL"
if command -v socx-doctor >/dev/null 2>&1; then
    run socx-doctor dnsbl
else
    echo "socx-doctor not installed." >> "$OUT"
fi

section "SOCX Doctor IDS"
if command -v socx-doctor >/dev/null 2>&1; then
    run socx-doctor ids
else
    echo "socx-doctor not installed." >> "$OUT"
fi

section "SOCX Rule Assistant"
if command -v socx-rule-assistant >/dev/null 2>&1; then
    run socx-rule-assistant
else
    echo "socx-rule-assistant not installed." >> "$OUT"
fi

section "SOCX Incident Timeline"
if command -v socx-timeline >/dev/null 2>&1; then
    run socx-timeline 120
else
    echo "socx-timeline not installed." >> "$OUT"
fi

section "SOCX Incident Memory"
if command -v socx-incident-memory >/dev/null 2>&1; then
    run socx-incident-memory summary 500
else
    echo "socx-incident-memory not installed." >> "$OUT"
fi

section "SOCX Doctor Traffic Totals"
if command -v socx-doctor >/dev/null 2>&1; then
    run socx-doctor vnstat
else
    echo "socx-doctor not installed." >> "$OUT"
fi

section "SOCX Doctor Log Pressure"
if command -v socx-doctor >/dev/null 2>&1; then
    run socx-doctor logs
else
    echo "socx-doctor not installed." >> "$OUT"
fi

section "Top PF States"
run sh -c 'pfctl -ss 2>/dev/null | head -80'

section "Service Watchdog"
run php -r 'require_once("config.inc"); print_r(config_get_path("installedpackages/servicewatchdog", []));'

section "Unknown Ports To Label"
if [ -f /var/db/socx_unknown_services.log ]; then
    echo "Top actionable unknown ports sampled from SOCX learner:" >> "$OUT"
    sed -n 's/.*port=\([0-9][0-9]*\).*/\1/p' /var/db/socx_unknown_services.log | awk '
      {
        port=$1+0
        if (port <= 1024 || port == 4000 || port == 5355 || port == 5443 || port == 8081 || port == 8089 || port == 8728 || port == 9042 || port == 9091) {
          count[port]++
        }
      }
      END {
        for (port in count) {
          printf "%d port=%s observations=%d\n", count[port], port, count[port]
        }
      }' | sort -nr | sed 's/^[0-9][0-9]* //' | head -30 >> "$OUT"
    echo "" >> "$OUT"
    echo "Recent raw learner lines:" >> "$OUT"
    tail -25 /var/db/socx_unknown_services.log >> "$OUT"
else
    echo "No unknown-service log yet." >> "$OUT"
fi

section "Host Audit"
if command -v socx-hosts-audit >/dev/null 2>&1; then
    SOCX_HOSTS_AUDIT_OUT=/tmp/socx-report-hosts.txt socx-hosts-audit >> "$OUT" 2>&1
else
    echo "socx-hosts-audit not installed." >> "$OUT"
fi

section "Recent Firewall Blocks"
run sh -c 'tail -200 /var/log/filter.log 2>/dev/null | grep -Ei ",block,|,reject," | tail -40'

section "Recent DNSBL"
run sh -c 'tail -80 /var/log/pfblockerng/dnsbl.log 2>/dev/null'

section "Recent IDS"
run sh -c 'find /var/log/suricata -type f -name alerts.log -maxdepth 2 2>/dev/null | xargs tail -80 2>/dev/null'

echo "$OUT"

#!/bin/sh
# Background Speedtest cache collector for SOCX wall mode.
#
# Runs expensive bandwidth tests on a schedule and writes a tiny env cache
# that socx-wall can read without blocking the 500 ms display loop.

CACHE=${SOCX_SPEEDTEST_CACHE_FILE:-/tmp/socx-speedtest-cache.env}
CLIENT_CACHE=${SOCX_SPEEDTEST_CLIENT_CACHE_FILE:-/tmp/socx-speedtest-client.env}
ROUTER_CACHE=${SOCX_SPEEDTEST_ROUTER_CACHE_FILE:-/tmp/socx-speedtest-router.env}
LOCK=${SOCX_SPEEDTEST_LOCK_FILE:-/tmp/socx-speedtest-cache.lock}
LOG=${SOCX_SPEEDTEST_LOG:-/tmp/socx-speedtest-cache.log}
SERVER_ID=${SOCX_SPEEDTEST_FRONTIER_SERVER_ID:-56485}
SERVER_NAME=${SOCX_SPEEDTEST_FRONTIER_SERVER_NAME:-Frontier}
SERVER_LOCATION=${SOCX_SPEEDTEST_FRONTIER_SERVER_LOCATION:-Secaucus, NJ}
MODE=${SOCX_SPEEDTEST_SERVER_MODE:-auto}
VPN_LOG=${SOCX_VPN_DEBUG_LOG:-/tmp/socx-wall-vpn.log}
OOKLA_SPEEDTEST=${SOCX_OOKLA_SPEEDTEST:-/usr/local/sbin/ookla-speedtest}

now_epoch() {
    /usr/local/bin/perl -MTime::HiRes=time -e 'printf "%.3f\n", time' 2>/dev/null || date +%s
}

clean_value() {
    printf '%s' "$1" | tr -d '\r' | sed 's/^"//; s/"$//; s/[[:cntrl:]]//g; s/[;&|`$<>]//g'
}

interval_seconds() {
    value=${SOCX_SPEEDTEST_INTERVAL:-${SOCX_SPEEDTEST_INTERVAL_SECONDS:-6h}}
    case "$value" in
    30m|30min|30mins) echo 1800 ;;
    1h|1hr|hour) echo 3600 ;;
    6h|6hr|6hrs) echo 21600 ;;
    *m) echo "$value" | awk '{ sub(/m$/, ""); printf "%d\n", ($1 + 0) * 60 }' ;;
    *h) echo "$value" | awk '{ sub(/h$/, ""); printf "%d\n", ($1 + 0) * 3600 }' ;;
    *) echo "$value" | awk '{ n=$1 + 0; if (n < 1800) n=1800; printf "%d\n", n }' ;;
    esac
}

cache_file_age() {
    file=$1
    [ -r "$file" ] || { echo 999999999; return; }
    updated=$(awk -F= '$1=="updated"{print $2; exit}' "$file" 2>/dev/null)
    awk -v now="$(now_epoch)" -v updated="$updated" 'BEGIN { if (updated == "") print 999999999; else printf "%.0f\n", now - updated }'
}

cache_file_is_fresh() {
    file=$1
    [ -r "$file" ] || return 1
    status=$(awk -F= '$1=="status"{print tolower($2); exit}' "$file" 2>/dev/null)
    [ "$status" = ok ] || return 1
    age=$(cache_file_age "$file")
    [ "$age" -le "$(interval_seconds)" ]
}

write_cache() {
    tmp="${CACHE}.$$"
    {
        printf 'updated=%s\n' "$(now_epoch)"
        printf 'status=%s\n' "$(clean_value "$1")"
        printf 'message=%s\n' "$(clean_value "$2")"
        printf 'mode=%s\n' "$(clean_value "$3")"
        printf 'tool=%s\n' "$(clean_value "$4")"
        printf 'download_mbps=%s\n' "$(clean_value "$5")"
        printf 'upload_mbps=%s\n' "$(clean_value "$6")"
        printf 'ping_ms=%s\n' "$(clean_value "$7")"
        printf 'jitter_ms=%s\n' "$(clean_value "$8")"
        printf 'server_id=%s\n' "$(clean_value "$9")"
        printf 'server_name=%s\n' "$(clean_value "${10}")"
        printf 'server_location=%s\n' "$(clean_value "${11}")"
        printf 'isp=%s\n' "$(clean_value "${12}")"
        printf 'external_ip=%s\n' "$(clean_value "${13}")"
        printf 'result_url=%s\n' "$(clean_value "${14}")"
        printf 'interval_seconds=%s\n' "$(interval_seconds)"
    } > "$tmp"
    case "$3" in
    client)
        cp "$tmp" "$CLIENT_CACHE" 2>/dev/null || true
        mv "$tmp" "$CACHE"
        ;;
    *)
        cp "$tmp" "$ROUTER_CACHE" 2>/dev/null || true
        if cache_file_is_fresh "$CLIENT_CACHE"; then
            rm -f "$tmp"
        else
            mv "$tmp" "$CACHE"
        fi
        ;;
    esac
}

speedtest_tool() {
    if [ "${SOCX_SPEEDTEST_PREFER_OOKLA:-false}" != "true" ] && command -v speedtest-go >/dev/null 2>&1; then
        echo speedtest-go
    elif [ "${SOCX_SPEEDTEST_PREFER_OOKLA:-false}" != "true" ] && command -v speedtest-cli >/dev/null 2>&1; then
        echo speedtest-cli
    elif [ -x "$OOKLA_SPEEDTEST" ]; then
        echo ookla:"$OOKLA_SPEEDTEST"
    elif command -v speedtest >/dev/null 2>&1 && speedtest --help 2>&1 | grep -q -- '--format'; then
        echo ookla:speedtest
    elif command -v speedtest-go >/dev/null 2>&1; then
        echo speedtest-go
    elif command -v speedtest-cli >/dev/null 2>&1; then
        echo speedtest-cli
    elif command -v speedtest >/dev/null 2>&1; then
        echo speedtest-python
    else
        echo ''
    fi
}

vpn_status_hint() {
    if [ -r "$VPN_LOG" ]; then
        line=$(tail -1 "$VPN_LOG" 2>/dev/null || true)
        case "$line" in
        *"status=UP"*|*"status=PARTIAL"*) echo vpn; return ;;
        *"status=DOWN"*|*"status=N/A"*) echo direct; return ;;
        esac
    fi
    if /sbin/ifconfig -l 2>/dev/null | grep -Eiq '(^| )(tun_wg|wg|ovpn|tun)[0-9A-Za-z_.-]*($| )'; then
        echo vpn
    else
        echo direct
    fi
}

selected_mode() {
    case "$MODE" in
    frontier|frontier-direct|direct) echo frontier ;;
    nearest|ookla-auto|location|vpn) echo auto ;;
    *)
        if [ "$(vpn_status_hint)" = "vpn" ]; then
            echo auto
        else
            echo frontier
        fi
        ;;
    esac
}

run_ookla_speedtest() {
    mode=$1
    bin=${2:-speedtest}
    if [ "$mode" = "frontier" ]; then
        raw=$("$bin" --accept-license --accept-gdpr --progress=no --format=json --server-id "$SERVER_ID" 2>&1) || \
            raw=$("$bin" --accept-license --accept-gdpr --progress=no --format=json 2>&1) || return 1
    else
        raw=$("$bin" --accept-license --accept-gdpr --progress=no --format=json 2>&1) || return 1
    fi
    printf '%s\n' "$raw" | awk '/^\{/{print}' | tail -1 | jq -r --arg mode "$mode" '
        [
          "ok",
          "ookla",
          ((.download.bandwidth // 0) * 8 / 1000000),
          ((.upload.bandwidth // 0) * 8 / 1000000),
          (.ping.latency // ""),
          (.ping.jitter // ""),
          (.server.id // ""),
          (.server.name // ""),
          (.server.location // ""),
          (.isp // ""),
          (.interface.externalIp // ""),
          (.result.url // "")
        ] | map(tostring) | join("|")'
}

run_speedtest_go() {
    mode=$1
    if [ "$mode" = "frontier" ]; then
        raw=$(speedtest-go --json --server "$SERVER_ID" --thread "${SOCX_SPEEDTEST_GO_THREADS:-8}" 2>&1) || return 1
    else
        raw=$(speedtest-go --json --thread "${SOCX_SPEEDTEST_GO_THREADS:-8}" 2>&1) || return 1
    fi
    printf '%s\n' "$raw" | awk '/^\{/{print}' | tail -1 | jq -r '
        .servers[0] as $s |
        [
          "ok",
          "speedtest-go",
          (($s.dl_speed // 0) * 8 / 1000000),
          (($s.ul_speed // 0) * 8 / 1000000),
          (($s.latency // 0) / 1000000),
          (($s.jitter // 0) / 1000000),
          ($s.id // ""),
          ($s.sponsor // ""),
          (($s.name // "") + (if ($s.country // "") != "" then ", " + $s.country else "" end)),
          (.user_info.Isp // ""),
          (.user_info.IP // ""),
          ""
        ] | map(tostring) | join("|")'
}

run_python_speedtest() {
    mode=$1
    bin=${2:-speedtest-cli}
    if [ "$mode" = "frontier" ]; then
        raw=$("$bin" --secure --json --server "$SERVER_ID" 2>&1) || return 1
    else
        raw=$("$bin" --secure --json 2>&1) || return 1
    fi
    printf '%s\n' "$raw" | jq -r --arg mode "$mode" '
        [
          "ok",
          "speedtest-cli",
          ((.download // 0) / 1000000),
          ((.upload // 0) / 1000000),
          (.ping // ""),
          "",
          (.server.id // ""),
          (.server.sponsor // ""),
          ((.server.name // "") + (if (.server.country // "") != "" then ", " + .server.country else "" end)),
          (.client.isp // ""),
          (.client.ip // ""),
          (.share // "")
        ] | map(tostring) | join("|")'
}

run_once() {
    tool=$(speedtest_tool)
    mode=$(selected_mode)
    if [ -z "$tool" ]; then
        write_cache missing "install speedtest or py311-speedtest-cli" "$mode" none "" "" "" "" "" "" "" "" "" ""
        return 1
    fi
    if ! command -v jq >/dev/null 2>&1; then
        write_cache missing "jq is required to parse speedtest JSON" "$mode" "$tool" "" "" "" "" "" "" "" "" "" ""
        return 1
    fi

    started=$(now_epoch)
    write_cache running "speedtest running" "$mode" "$tool" "" "" "" "" "$([ "$mode" = frontier ] && printf '%s' "$SERVER_ID")" "$([ "$mode" = frontier ] && printf '%s' "$SERVER_NAME")" "$([ "$mode" = frontier ] && printf '%s' "$SERVER_LOCATION")" "" "" ""
    case "$tool" in
    ookla:*)
        ookla_bin=${tool#ookla:}
        parsed=$(run_ookla_speedtest "$mode" "$ookla_bin") || {
            write_cache error "speedtest failed" "$mode" "$tool" "" "" "" "" "" "" "" "" "" ""
            return 1
        }
        ;;
    speedtest-go)
        parsed=$(run_speedtest_go "$mode") || {
            write_cache error "speedtest-go failed" "$mode" "$tool" "" "" "" "" "" "" "" "" "" ""
            return 1
        }
        ;;
    *)
        pybin=speedtest-cli
        [ "$tool" = speedtest-python ] && pybin=speedtest
        parsed=$(run_python_speedtest "$mode" "$pybin") || {
            write_cache error "speedtest-cli failed" "$mode" "$tool" "" "" "" "" "" "" "" "" "" ""
            return 1
        }
        ;;
    esac

    IFS='|' read -r status tool_name down up ping jitter sid sname sloc isp ip url <<EOF
$parsed
EOF
    if [ "$tool" = speedtest-go ] && awk -v d="$down" -v u="$up" 'BEGIN { exit !((d + 0) < 0 || (u + 0) < 0) }'; then
        parsed=$(run_speedtest_go auto) && mode=auto || parsed=''
        if [ -z "$parsed" ] && [ -x "$OOKLA_SPEEDTEST" ]; then
            parsed=$(run_ookla_speedtest "$mode" "$OOKLA_SPEEDTEST") || parsed=''
        fi
        if [ -z "$parsed" ] && command -v speedtest >/dev/null 2>&1 && speedtest --help 2>&1 | grep -q -- '--format'; then
            parsed=$(run_ookla_speedtest "$mode" speedtest) || parsed=''
        fi
        if [ -z "$parsed" ] && command -v speedtest-cli >/dev/null 2>&1; then
            parsed=$(run_python_speedtest auto speedtest-cli) && mode=auto || parsed=''
        fi
        if [ -n "$parsed" ]; then
            IFS='|' read -r status tool_name down up ping jitter sid sname sloc isp ip url <<EOF
$parsed
EOF
        fi
    fi
    [ -n "$sname" ] || sname=$SERVER_NAME
    [ -n "$sloc" ] || sloc=$SERVER_LOCATION
    if [ "$mode" = frontier ]; then
        [ -n "$sid" ] || sid=$SERVER_ID
        [ -n "$sname" ] || sname=$SERVER_NAME
        [ -n "$sloc" ] || sloc=$SERVER_LOCATION
    fi
    message=$(awk -v s="$started" -v e="$(now_epoch)" 'BEGIN { printf "complete in %.0fs", e - s }')
    down=$(printf '%s' "$down" | awk '{ printf "%.0f", $1 + 0 }')
    up=$(printf '%s' "$up" | awk '{ printf "%.0f", $1 + 0 }')
    ping=$(printf '%s' "$ping" | awk '{ if ($1 == "") print ""; else printf "%.0f", $1 + 0 }')
    jitter=$(printf '%s' "$jitter" | awk '{ if ($1 == "") print ""; else printf "%.0f", $1 + 0 }')
    if awk -v d="$down" -v u="$up" 'BEGIN { exit !(d <= 0 || u <= 0) }'; then
        write_cache error "invalid speedtest result" "$mode" "$tool_name" "" "" "$ping" "$jitter" "$sid" "$sname" "$sloc" "$isp" "$ip" "$url"
        return 1
    fi
    write_cache ok "$message" "$mode" "$tool_name" "$down" "$up" "$ping" "$jitter" "$sid" "$sname" "$sloc" "$isp" "$ip" "$url"
}

cache_age() {
    [ -r "$CACHE" ] || { echo 999999999; return; }
    cache_file_age "$CACHE"
}

with_lock() {
    if mkdir "$LOCK" 2>/dev/null; then
        printf '%s\n' "$$" > "$LOCK/pid"
        trap 'rm -f "$LOCK/pid" 2>/dev/null || true; rmdir "$LOCK" 2>/dev/null || true' EXIT INT TERM
        run_once
        rc=$?
        rm -f "$LOCK/pid" 2>/dev/null || true
        rmdir "$LOCK" 2>/dev/null || true
        trap - EXIT INT TERM
        return "$rc"
    else
        lock_pid=$(cat "$LOCK/pid" 2>/dev/null || true)
        if [ -n "$lock_pid" ] && ! kill -0 "$lock_pid" 2>/dev/null; then
            rm -f "$LOCK/pid" 2>/dev/null || true
            rmdir "$LOCK" 2>/dev/null || true
            with_lock
            return
        fi
        if [ -z "$lock_pid" ] && [ "$(cache_age)" -ge "$(( $(interval_seconds) + 300 ))" ]; then
            rm -f "$LOCK/pid" 2>/dev/null || true
            rmdir "$LOCK" 2>/dev/null || true
            with_lock
            return
        fi
        return 0
    fi
}

import_result() {
    down=${1:-${SOCX_SPEEDTEST_IMPORT_DOWN:-}}
    up=${2:-${SOCX_SPEEDTEST_IMPORT_UP:-}}
    ping=${3:-${SOCX_SPEEDTEST_IMPORT_PING:-}}
    jitter=${4:-${SOCX_SPEEDTEST_IMPORT_JITTER:-}}
    sid=${5:-${SOCX_SPEEDTEST_IMPORT_SERVER_ID:-}}
    sname=${6:-${SOCX_SPEEDTEST_IMPORT_SERVER_NAME:-}}
    sloc=${7:-${SOCX_SPEEDTEST_IMPORT_SERVER_LOCATION:-}}
    isp=${8:-${SOCX_SPEEDTEST_IMPORT_ISP:-}}
    ip=${9:-${SOCX_SPEEDTEST_IMPORT_IP:-}}
    url=${10:-${SOCX_SPEEDTEST_IMPORT_URL:-}}
    down=$(printf '%s' "$down" | awk '{ printf "%.0f", $1 + 0 }')
    up=$(printf '%s' "$up" | awk '{ printf "%.0f", $1 + 0 }')
    ping=$(printf '%s' "$ping" | awk '{ if ($1 == "") print ""; else printf "%.0f", $1 + 0 }')
    jitter=$(printf '%s' "$jitter" | awk '{ if ($1 == "") print ""; else printf "%.0f", $1 + 0 }')
    if awk -v d="$down" -v u="$up" 'BEGIN { exit !(d <= 0 || u <= 0) }'; then
        echo "import requires positive download and upload Mbps" >&2
        return 2
    fi
    [ -n "$sname" ] || sname="Speedtest.net"
    [ -n "$sloc" ] || sloc="client result"
    write_cache ok "imported client Speedtest result" "client" "speedtest-net" "$down" "$up" "$ping" "$jitter" "$sid" "$sname" "$sloc" "$isp" "$ip" "$url"
}

case "${1:-loop}" in
once)
    with_lock
    ;;
import)
    shift
    import_result "$@"
    ;;
loop)
    while :; do
        interval=$(interval_seconds)
        age=$(cache_age)
        if [ "$age" -ge "$interval" ]; then
            with_lock >>"$LOG" 2>&1 || true
            sleep 5
        else
            sleep_for=$((interval - age))
            [ "$sleep_for" -lt 10 ] && sleep_for=10
            [ "$sleep_for" -gt 300 ] && sleep_for=300
            sleep "$sleep_for"
        fi
    done
    ;;
*)
    echo "Usage: socx-speedtest-cache [once|loop|import down up ping jitter server_id server_name server_location isp ip url]" >&2
    exit 2
    ;;
esac

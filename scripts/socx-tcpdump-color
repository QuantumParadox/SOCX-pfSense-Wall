#!/bin/sh
# Colorized tcpdump stream for SOCX. Original tcpdump is untouched.
if [ "${1:-}" = "--demo" ]; then
    cat <<'EOF' | /usr/local/sbin/socx_tcpdump_color.pl
10:51:24.123456 IP 192.168.1.121.443 > 74.46.12.1.51515: Flags [P.], seq 1:120, ack 2, win 1024, length 119
10:51:25.123456 IP 192.168.1.161.5353 > 224.0.0.251.5353: UDP, length 44
10:51:26.123456 ARP, Request who-has 192.168.1.180 tell 192.168.1.1, length 28
EOF
    exit 0
fi

if [ "$#" -eq 0 ]; then
    set -- -i ix1 -nn -q
fi

iface="ix1"
prev=""
for arg in "$@"; do
    if [ "$prev" = "-i" ]; then
        iface="$arg"
        break
    fi
    prev="$arg"
done
SOCX_TCPDUMP_IFACE="$iface"
SOCX_WAN_ADDR="$(/sbin/ifconfig "$iface" 2>/dev/null | /usr/bin/awk '/inet / { print $2; exit }')"
export SOCX_TCPDUMP_IFACE SOCX_WAN_ADDR

if [ -n "${TMUX_PANE:-}" ] && command -v tmux >/dev/null 2>&1; then
    dims="$(tmux display-message -p -t "$TMUX_PANE" '#{pane_width} #{pane_height}' 2>/dev/null || echo '0 0')"
    SOCX_WIDTH="${dims%% *}"
    SOCX_HEIGHT="${dims##* }"
else
    SOCX_WIDTH="$(tput cols 2>/dev/null || echo 0)"
    SOCX_HEIGHT="$(tput lines 2>/dev/null || echo 0)"
fi
export SOCX_WIDTH SOCX_HEIGHT
[ "${SOCX_WIDTH:-0}" -lt 70 ] 2>/dev/null && export SOCX_COMPACT=1

/usr/sbin/tcpdump -l "$@" 2>&1 | /usr/local/sbin/socx_tcpdump_color.pl
